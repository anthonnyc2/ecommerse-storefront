{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://raquel-boutique.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
