---
// CartDrawer.astro
---

<div
  id="cart-drawer"
  class="relative z-[100] hidden"
  aria-labelledby="slide-over-title"
  role="dialog"
  aria-modal="true"
>
  <div
    id="cart-overlay"
    class="fixed inset-0 bg-gray-500/75 transition-opacity opacity-0 pointer-events-none"
  >
  </div>

  <div class="fixed inset-0 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10"
      >
        <div
          id="cart-panel"
          class="pointer-events-auto w-screen max-w-md translate-x-full transform transition ease-in-out duration-500 sm:duration-700"
        >
          <div
            class="flex h-full flex-col overflow-y-scroll bg-white shadow-xl"
          >
            <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-6">
              <div class="flex items-center justify-between">
                <h2
                  class="text-xl font-semibold tracking-tight text-gray-900"
                  id="slide-over-title"
                >
                  Tu Carrito
                </h2>
                <button
                  id="close-cart"
                  type="button"
                  class="flex h-9 w-9 items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
                >
                  <span class="sr-only">Cerrar panel</span>
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>
              </div>

              <div class="mt-8">
                <div class="flow-root">
                  <ul
                    id="cart-items-list"
                    role="list"
                    class="-my-6 divide-y divide-gray-200"
                  >
                    <!-- Items will be injected here -->
                  </ul>
                  <div
                    id="empty-cart-message"
                    class="flex flex-col items-center justify-center py-16 hidden"
                  >
                    <div
                      class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-gray-400"
                    >
                      <svg
                        class="h-8 w-8"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"
                        ></path>
                      </svg>
                    </div>
                    <p class="mt-4 text-base font-medium text-gray-900">
                      Tu carrito está vacío
                    </p>
                    <p class="mt-1 text-sm text-gray-500">
                      Agrega productos desde el catálogo
                    </p>
                    <a
                      href="/catalogo"
                      class="mt-6 inline-block rounded-full bg-secondary px-6 py-2.5 text-sm font-semibold text-gray-900 hover:bg-secondary/80 transition-colors"
                      >Ver catálogo</a
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-gray-100 px-4 py-6 sm:px-6">
              <div class="flex items-baseline justify-between">
                <p class="text-sm text-gray-500">Subtotal</p>
                <p
                  id="cart-subtotal"
                  class="text-xl font-semibold text-gray-900"
                >
                  0 Bs
                </p>
              </div>
              <p class="mt-1 text-xs text-gray-400">
                Envío no incluido — coordinamos la entrega por WhatsApp.
              </p>
              <div class="mt-5">
                <button
                  id="checkout-whatsapp"
                  class="flex w-full items-center justify-center gap-2.5 rounded-full bg-[#25D366] px-6 py-3.5 text-sm font-semibold text-white shadow-sm hover:bg-[#1ebe5d] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2"
                >
                  <svg
                    class="h-5 w-5 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                    ></path>
                  </svg>
                  Comprar por WhatsApp
                </button>
              </div>
              <button
                id="continue-shopping"
                type="button"
                class="mt-3 w-full rounded-full border border-gray-200 px-6 py-3 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
              >
                Continuar comprando
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import Clarity from "@microsoft/clarity";
  import { cartItems, removeItem, updateQuantity } from "../services/cartStore";

  const cartDrawer = document.getElementById("cart-drawer");
  const cartOverlay = document.getElementById("cart-overlay");
  const cartPanel = document.getElementById("cart-panel");
  const closeCart = document.getElementById("close-cart");
  const continueShopping = document.getElementById("continue-shopping");
  const cartSubtotal = document.getElementById("cart-subtotal");
  const checkoutBtn = document.getElementById("checkout-whatsapp");
  const cartItemsList = document.getElementById("cart-items-list");
  const emptyCartMessage = document.getElementById("empty-cart-message");

  // CSS Class Constants to satisfy sonarjs/no-duplicate-string
  const OPACITY_100 = "opacity-100";
  const POINTER_EVENTS_NONE = "pointer-events-none";
  const HIDDEN = "hidden";
  const TRANSLATE_X_FULL = "translate-x-full";
  const OPACITY_50 = "opacity-50";

  function openCart() {
    cartDrawer?.classList.remove(HIDDEN);
    setTimeout(() => {
      cartOverlay?.classList.add(OPACITY_100);
      cartOverlay?.classList.remove(POINTER_EVENTS_NONE);
      cartPanel?.classList.remove(TRANSLATE_X_FULL);
      // Focus the close button when the drawer opens for accessibility
      closeCart?.focus();
    }, 10);
  }

  function closeCartDrawer() {
    cartOverlay?.classList.remove(OPACITY_100);
    cartOverlay?.classList.add(POINTER_EVENTS_NONE);
    cartPanel?.classList.add(TRANSLATE_X_FULL);
    setTimeout(() => {
      cartDrawer?.classList.add(HIDDEN);
      // Return focus to the cart trigger button
      document.getElementById("cart-button")?.focus();
    }, 500);
  }

  // Focus trap logic
  cartDrawer?.addEventListener("keydown", (e) => {
    if (e.key === "Tab") {
      const focusableElements = cartDrawer.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
      );
      const firstElement = focusableElements[0] as HTMLElement;
      const lastElement = focusableElements[
        focusableElements.length - 1
      ] as HTMLElement;

      if (e.shiftKey) {
        // Shift + Tab
        if (document.activeElement === firstElement) {
          lastElement.focus();
          e.preventDefault();
        }
      } else {
        // Tab
        if (document.activeElement === lastElement) {
          firstElement.focus();
          e.preventDefault();
        }
      }
    }
  });

  window.addEventListener("toggle-cart", () => {
    openCart();
  });

  closeCart?.addEventListener("click", closeCartDrawer);
  continueShopping?.addEventListener("click", closeCartDrawer);
  cartOverlay?.addEventListener("click", closeCartDrawer);

  cartItems.subscribe((items) => {
    if (!cartItemsList) return;

    if (items.length === 0) {
      if (cartItemsList) cartItemsList.innerHTML = "";
      emptyCartMessage?.classList.remove(HIDDEN);
      checkoutBtn?.classList.add(OPACITY_50, POINTER_EVENTS_NONE);
      if (cartSubtotal) cartSubtotal.textContent = "0 Bs";
      return;
    }

    emptyCartMessage?.classList.add(HIDDEN);
    checkoutBtn?.classList.remove(OPACITY_50, POINTER_EVENTS_NONE);

    cartItemsList.innerHTML = items
      .map((item) => {
        const colorPill = item.color
          ? `<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 capitalize">${item.color}</span>`
          : "";
        const sizePill = item.size
          ? `<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Talla: ${item.size}</span>`
          : "";

        return `
      <li class="flex py-5 gap-4">
        <div class="h-28 w-24 flex-shrink-0 overflow-hidden rounded-xl bg-gray-50">
          <img src="${item.image}" alt="${item.name}" class="h-full w-full object-cover object-center">
        </div>

        <div class="flex flex-1 flex-col min-w-0">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <h3 class="text-sm font-semibold text-gray-900 leading-tight">
                <a href="/producto/${item.slug}" class="hover:text-secondary transition-colors focus:outline-none focus-visible:underline">${item.name}</a>
              </h3>
              ${item.brand ? `<p class="mt-0.5 text-xs text-gray-400 uppercase tracking-wide">${item.brand}</p>` : ""}
            </div>
            <p class="shrink-0 text-sm font-semibold text-gray-900">${item.price * item.quantity} Bs</p>
          </div>

          ${colorPill || sizePill ? `<div class="mt-2 flex flex-wrap gap-1">${colorPill}${sizePill}</div>` : ""}

          <div class="mt-auto pt-3 flex items-center justify-between">
            <div class="flex items-center gap-1 rounded-full border border-gray-200 bg-white px-1">
              <button class="flex h-7 w-7 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 hover:text-gray-900 decrease-qty transition-colors focus:outline-none" data-id="${item.id}" aria-label="Disminuir cantidad de ${item.name}">−</button>
              <span class="w-6 text-center text-sm font-semibold text-gray-900" aria-label="Cantidad">${item.quantity}</span>
              <button class="flex h-7 w-7 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 hover:text-gray-900 increase-qty transition-colors focus:outline-none" data-id="${item.id}" aria-label="Aumentar cantidad de ${item.name}">+</button>
            </div>
            <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full text-gray-400 hover:bg-red-50 hover:text-red-500 remove-item transition-colors focus:outline-none" data-id="${item.id}" aria-label="Eliminar ${item.name}">
              <svg class="h-4 w-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      </li>
    `;
      })
      .join("");

    const total = items.reduce(
      (acc, item) => acc + item.price * item.quantity,
      0,
    );
    if (cartSubtotal) cartSubtotal.textContent = `${total} Bs`;

    // Add event listeners to new buttons
    document.querySelectorAll(".remove-item").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.target as HTMLElement).getAttribute("data-id");
        if (id) {
          Clarity.event("RemoveFromCart");
          removeItem(id);
        }
      });
    });

    document.querySelectorAll(".decrease-qty").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.target as HTMLElement).getAttribute("data-id");
        const item = items.find((i) => i.id === id);
        if (id && item) updateQuantity(id, item.quantity - 1);
      });
    });

    document.querySelectorAll(".increase-qty").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.target as HTMLElement).getAttribute("data-id");
        const item = items.find((i) => i.id === id);
        if (id && item) updateQuantity(id, item.quantity + 1);
      });
    });
  });

  checkoutBtn?.addEventListener("click", () => {
    const items = cartItems.get();
    if (items.length === 0) return;

    Clarity.event("CheckoutStarted");

    const total = items.reduce(
      (acc, item) => acc + item.price * item.quantity,
      0,
    );

    let message =
      "¡Hola! Me gustaría realizar el siguiente pedido por Raquel Boutique:\n\n";

    items.forEach((item) => {
      const quantityLine = `• ${item.quantity}x *${item.name}*\n`;
      message += quantityLine;

      if (item.color || item.size) {
        let options = "  (";
        if (item.color) options += `Color: ${item.color}`;
        if (item.color && item.size) options += ", ";
        if (item.size) options += `Talla: ${item.size}`;
        options += ")\n";
        message += options;
      }

      const priceLine = `  Precio: ${item.price * item.quantity} Bs\n\n`;
      message += priceLine;
    });

    message += `*Total: ${total} Bs*\n\n`;
    message += "¿Podrían confirmarme la disponibilidad?";

    const whatsappUrl = `https://api.whatsapp.com/send/?phone=59165864255&text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, "_blank");
  });
</script>
