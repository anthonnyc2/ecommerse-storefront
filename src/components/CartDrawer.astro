---
// CartDrawer.astro
import defaultImg from "../assets/default-product-image.png";
---

<div id="cart-drawer" class="relative z-[100] hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
  <div id="cart-overlay" class="fixed inset-0 bg-gray-500/75 transition-opacity opacity-0 pointer-events-none"></div>

  <div class="fixed inset-0 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
        <div id="cart-panel" class="pointer-events-auto w-screen max-w-md translate-x-full transform transition ease-in-out duration-500 sm:duration-700">
          <div class="flex h-full flex-col overflow-y-scroll bg-white shadow-xl">
            <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-6">
              <div class="flex items-start justify-between">
                <h2 class="text-lg font-medium text-gray-900" id="slide-over-title">Carrito de Compras</h2>
                <div class="ml-3 flex h-7 items-center">
                  <button id="close-cart" type="button" class="relative -m-2 p-2 text-gray-400 hover:text-gray-500">
                    <span class="absolute -inset-0.5"></span>
                    <span class="sr-only">Cerrar panel</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="mt-8">
                <div class="flow-root">
                  <ul id="cart-items-list" role="list" class="-my-6 divide-y divide-gray-200">
                    <!-- Items will be injected here -->
                  </ul>
                  <div id="empty-cart-message" class="text-center py-10 hidden">
                    <p class="text-gray-500">Tu carrito está vacío.</p>
                    <a href="/catalogo" class="mt-4 inline-block text-secondary font-medium hover:underline">Ir al catálogo</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-gray-200 px-4 py-6 sm:px-6">
              <div class="flex justify-between text-base font-medium text-gray-900">
                <p>Subtotal</p>
                <p id="cart-subtotal">0 Bs</p>
              </div>
              <p class="mt-0.5 text-sm text-gray-500">Envío no incluido. Coordinaremos la entrega por WhatsApp.</p>
              <div class="mt-6">
                <button
                  id="checkout-whatsapp"
                  class="flex w-full items-center justify-center gap-3 rounded-xl bg-green-600 px-6 py-3 text-base font-medium text-white shadow-sm hover:bg-green-700 transition-all"
                >
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                  </svg>
                  Comprar por WhatsApp
                </button>
              </div>
              <div class="mt-6 flex justify-center text-center text-sm text-gray-500">
                <p>
                  o
                  <button id="continue-shopping" type="button" class="font-medium text-secondary hover:text-primary">
                    Continuar comprando
                    <span aria-hidden="true"> &rarr;</span>
                  </button>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { cartItems, removeItem, updateQuantity } from '../services/cartStore';

  const cartDrawer = document.getElementById('cart-drawer');
  const cartOverlay = document.getElementById('cart-overlay');
  const cartPanel = document.getElementById('cart-panel');
  const closeCart = document.getElementById('close-cart');
  const continueShopping = document.getElementById('continue-shopping');
  const cartItemsList = document.getElementById('cart-items-list');
  const emptyCartMessage = document.getElementById('empty-cart-message');
  const cartSubtotal = document.getElementById('cart-subtotal');
  const checkoutBtn = document.getElementById('checkout-whatsapp');

  function openCart() {
    cartDrawer?.classList.remove('hidden');
    setTimeout(() => {
      cartOverlay?.classList.add('opacity-100');
      cartOverlay?.classList.remove('pointer-events-none');
      cartPanel?.classList.remove('translate-x-full');
    }, 10);
  }

  function closeCartDrawer() {
    cartOverlay?.classList.remove('opacity-100');
    cartOverlay?.classList.add('pointer-events-none');
    cartPanel?.classList.add('translate-x-full');
    setTimeout(() => {
      cartDrawer?.classList.add('hidden');
    }, 500);
  }

  window.addEventListener('toggle-cart', () => {
    openCart();
  });

  closeCart?.addEventListener('click', closeCartDrawer);
  continueShopping?.addEventListener('click', closeCartDrawer);
  cartOverlay?.addEventListener('click', closeCartDrawer);

  cartItems.subscribe((items) => {
    if (!cartItemsList) return;

    if (items.length === 0) {
      cartItemsList.innerHTML = '';
      emptyCartMessage?.classList.remove('hidden');
      checkoutBtn?.classList.add('opacity-50', 'pointer-events-none');
      if (cartSubtotal) cartSubtotal.textContent = '0 Bs';
      return;
    }

    emptyCartMessage?.classList.add('hidden');
    checkoutBtn?.classList.remove('opacity-50', 'pointer-events-none');

    cartItemsList.innerHTML = items.map(item => `
      <li class="flex py-6">
        <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-md border border-gray-200">
          <img src="${item.image}" alt="${item.name}" class="h-full w-full object-cover object-center">
        </div>

        <div class="ml-4 flex flex-1 flex-col">
          <div>
            <div class="flex justify-between text-base font-medium text-gray-900">
              <h3>
                <a href="/producto/${item.slug}">${item.name}</a>
              </h3>
              <p class="ml-4">${item.price * item.quantity} Bs</p>
            </div>
            <p class="mt-1 text-sm text-gray-500">${item.brand || ''}</p>
            <p class="mt-1 text-xs text-gray-400">
              ${item.color ? `Color: ${item.color}` : ''} 
              ${item.size ? ` | Talla: ${item.size}` : ''}
            </p>
          </div>
          <div class="flex flex-1 items-end justify-between text-sm">
            <div class="flex items-center border rounded-lg">
              <button class="px-2 py-1 hover:bg-gray-100 decrease-qty" data-id="${item.id}">-</button>
              <span class="px-3 py-1 font-medium">${item.quantity}</span>
              <button class="px-2 py-1 hover:bg-gray-100 increase-qty" data-id="${item.id}">+</button>
            </div>

            <div class="flex">
              <button type="button" class="font-medium text-secondary hover:text-primary remove-item" data-id="${item.id}">Eliminar</button>
            </div>
          </div>
        </div>
      </li>
    `).join('');

    const total = items.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    if (cartSubtotal) cartSubtotal.textContent = `${total} Bs`;

    // Add event listeners to new buttons
    document.querySelectorAll('.remove-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.target as HTMLElement).getAttribute('data-id');
        if (id) removeItem(id);
      });
    });

    document.querySelectorAll('.decrease-qty').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.target as HTMLElement).getAttribute('data-id');
        const item = items.find(i => i.id === id);
        if (id && item) updateQuantity(id, item.quantity - 1);
      });
    });

    document.querySelectorAll('.increase-qty').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.target as HTMLElement).getAttribute('data-id');
        const item = items.find(i => i.id === id);
        if (id && item) updateQuantity(id, item.quantity + 1);
      });
    });
  });

  checkoutBtn?.addEventListener('click', () => {
    const items = cartItems.get();
    if (items.length === 0) return;

    const total = items.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    
    let message = "¡Hola! Me gustaría realizar el siguiente pedido por Raquel Boutique:\n\n";
    
    items.forEach(item => {
      message += `• ${item.quantity}x *${item.name}*\n`;
      if (item.color || item.size) {
        message += `  (${item.color ? `Color: ${item.color}` : ''}${item.color && item.size ? ', ' : ''}${item.size ? `Talla: ${item.size}` : ''})\n`;
      }
      message += `  Precio: ${item.price * item.quantity} Bs\n\n`;
    });

    message += `*Total: ${total} Bs*\n\n`;
    message += "¿Podrían confirmarme la disponibilidad?";

    const whatsappUrl = `https://api.whatsapp.com/send/?phone=59165864255&text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, "_blank");
  });
</script>
