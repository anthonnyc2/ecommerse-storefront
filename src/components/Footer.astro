---
import logo from "../assets/r_logo.svg";

const currentYear = new Date().getFullYear();
const whatsappUrl =
  "https://api.whatsapp.com/send/?phone=59165864255&text=Hola%2C%20me%20gustar%C3%ADa%20ver%20sus%20productos%20%F0%9F%9B%8D%EF%B8%8F";
---

<footer class="bg-gray-900 text-white">
  <div class="mx-auto max-w-screen-2xl px-4 md:px-8 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3">
          <img src={logo.src} alt="Raquel Boutique Logo" class="h-10 w-auto" />
          <span class="text-lg font-semibold tracking-tight"
            >Raquel Boutique</span
          >
        </a>
        <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
          Moda femenina en Santa Cruz, Bolivia. Envíos a todo el país y delivery
          a domicilio por Yango.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3
          class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-400"
        >
          Navegación
        </h3>
        <ul class="flex flex-col gap-2.5 text-sm">
          <li>
            <a
              href="/"
              class="text-gray-300 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary rounded"
            >
              Inicio
            </a>
          </li>
          <li>
            <a
              href="/catalogo"
              class="text-gray-300 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary rounded"
            >
              Catálogo
            </a>
          </li>
          <li>
            <a
              href="/contacto"
              class="text-gray-300 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary rounded"
            >
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3
          class="mb-4 text-sm font-semibold uppercase tracking-widest text-gray-400"
        >
          Contáctanos
        </h3>
        <p class="mb-4 text-sm text-gray-400 leading-relaxed">
          Hacemos pedidos por WhatsApp. Escríbenos y te asesoramos con tu talla
          y estilo.
        </p>
        <a
          href={whatsappUrl}
          data-track="click_contact"
          data-placement="footer"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp btn-md gap-2 focus-visible:ring-offset-gray-900"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
            ></path>
          </svg>
          Escribir por WhatsApp
        </a>
        <p class="mt-4 text-sm text-gray-400">
          O por correo:{" "}
          <a
            href="mailto:contacto@raquel-boutique.com"
            data-track="click_contact"
            data-contact-method="email"
            data-placement="footer"
            class="font-medium text-gray-300 underline underline-offset-2 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
            >contacto@raquel-boutique.com</a
          >
        </p>
      </div>
    </div>

    <div
      class="mt-10 border-t border-gray-800 pt-6 text-center text-xs text-gray-400"
    >
      &copy; {currentYear} Raquel Boutique. Todos los derechos reservados.
    </div>
  </div>
</footer>
