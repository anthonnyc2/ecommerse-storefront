---
interface Props {
  id: string;
  images: string[];
  title: string;
  price: string;
  categories: string[];
  color: string;
  sizes: string[];
}

const { id, images, title, price, categories, color, sizes } = Astro.props;
const [mainImage, hoverImage] = images;

// Transform Cloudinary URL to add optimization parameters
const transformCloudinaryUrl = (url: string): string => {
  if (!url || !url.includes("cloudinary.com")) return url;
  return url.replace("/upload/", "/upload/w_600,h_600,c_fill,f_auto,q_auto/");
};

const optimizedMainImage = transformCloudinaryUrl(mainImage);
const optimizedHoverImage = hoverImage
  ? transformCloudinaryUrl(hoverImage)
  : null;
---

<a
  href={`/products/${id}`}
  class="group relative block overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:shadow-md"
>
  <div class="relative h-[400px] overflow-hidden">
    <!-- Main Image -->
    <img
      src={optimizedMainImage}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-0"
    />
    <!-- Hover Image (Second image) -->
    {
      optimizedHoverImage && (
        <img
          src={optimizedHoverImage}
          alt={`${title} - Vista alternativa`}
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      )
    }

    <div
      class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10"
    >
    </div>
  </div>

  <div class="p-5">
    <h3
      class="text-lg font-medium text-gray-900 group-hover:text-secondary transition-colors"
    >
      {title}
    </h3>
    <p class="mt-1 text-gray-500 font-light">{price} Bs</p>

    <!-- Sizes -->
    <div class="mt-3 flex gap-2">
      {
        sizes.map((size) => (
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 text-xs text-gray-600 transition-colors hover:border-gray-900 hover:bg-gray-900 hover:text-white">
            {size}
          </span>
        ))
      }
    </div>

    <div
      class="mt-4 w-full rounded-lg bg-gray-900 py-3 text-center text-sm font-medium text-white transition-transform active:scale-95 group-hover:bg-secondary"
    >
      Ver Detalles
    </div>
  </div>
</a>
