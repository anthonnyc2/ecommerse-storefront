---
import type { PublicProductWithDetails } from "../types/api";
import defaultImg from "../assets/default-product-image.png";
import { serializeVariants } from "../services/quickAdd";

interface Props {
  product: PublicProductWithDetails;
  /** Set to true for the very first card so the browser prioritises its image as LCP */
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const { slug, name, variants, images } = product;

// Extract images
const imageUrls = images.map((img) => img.url);
const [mainImage, hoverImage] =
  imageUrls.length > 0 ? imageUrls : [defaultImg.src, null];

// Extract base price, unique sizes and colors
const basePrice =
  variants.length > 0 ? Math.min(...variants.map((v) => v.price)) : 0;
const allSizes = [...new Set(variants.map((v) => v.size).filter(Boolean))];
const visibleSizes = allSizes.slice(0, 4);
const extraSizes = allSizes.length > 4 ? allSizes.length - 4 : 0;
const allColors = [
  ...new Set(variants.map((v) => v.color).filter(Boolean)),
] as string[];
const visibleColors = allColors.slice(0, 4);
const extraColors = allColors.length > 4 ? allColors.length - 4 : 0;

// Optimization helper
const transformImageUrl = (url: string | null): string => {
  if (!url || url === defaultImg.src) return defaultImg.src;

  // Cloudinary: apply automatic format + quality optimisation
  if (url.includes("cloudinary.com")) {
    return url.replace("/upload/", "/upload/w_600,h_600,c_fill,f_auto,q_auto/");
  }

  // Supabase
  // if (url.includes("supabase.co") && url.includes("/storage/v1/object/public/")) {
  //   return url.replace("/storage/v1/object/public/", "/storage/v1/render/image/public/") + "?width=600&quality=75";
  // }

  return url;
};

const optimizedMainImage = transformImageUrl(mainImage);
const optimizedHoverImage = hoverImage ? transformImageUrl(hoverImage) : null;

// Quick add needs the in-stock variants and one photo per color for the cart.
const quickAddVariants = serializeVariants(variants);
const canQuickAdd = variants.some((v) => v.stock > 0);
const colorImages: Record<string, string> = {};
for (const img of images) {
  if (img.color && !colorImages[img.color]) {
    colorImages[img.color] = transformImageUrl(img.url);
  }
}
---

<div
  data-item-id={slug}
  data-item-name={name}
  data-item-category={product.category ?? ""}
  data-item-brand={product.brand ?? ""}
  data-price={basePrice}
  data-variants={quickAddVariants}
  data-image={optimizedMainImage}
  data-color-images={JSON.stringify(colorImages)}
  class="group relative block overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:shadow-md focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2"
>
  <div class="relative h-[400px] overflow-hidden bg-gray-200">
    <!-- Skeleton shimmer shown while the image loads -->
    <div class="absolute inset-0 animate-pulse bg-gray-200" aria-hidden="true">
    </div>
    <!-- Main Image: eager + high priority for LCP card, lazy + async for the rest -->
    <img
      src={optimizedMainImage}
      alt={name}
      width="400"
      height="400"
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "low"}
      onload="this.previousElementSibling.remove()"
      class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ${optimizedHoverImage ? "group-hover:opacity-0" : ""}`}
    />
    <!-- Hover Image (Second image) - always lazy -->
    {
      optimizedHoverImage && (
        <img
          src={optimizedHoverImage}
          alt={`${name} - Vista alternativa`}
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      )
    }

    <div
      class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10"
    >
    </div>
  </div>

  <div class="p-5">
    <h3
      class="text-base font-semibold tracking-tight text-gray-900 transition-colors group-hover:text-secondary"
    >
      <!-- Stretched link: the ::after covers the whole card, buttons sit above it -->
      <a
        href={`/producto/${slug}`}
        data-track="select_item"
        class="outline-none after:absolute after:inset-0 after:content-['']"
        >{name}</a
      >
    </h3>
    <p class="mt-1 text-sm font-medium text-gray-500">Desde {basePrice} Bs</p>

    <!-- Colors -->
    {
      visibleColors.length > 0 && (
        <div class="mt-3 flex flex-wrap items-center gap-1.5">
          {visibleColors.map((color) => (
            <span class="flex items-center justify-center rounded-md border border-gray-200 px-1.5 py-0.5 text-[11px] font-medium capitalize text-gray-600">
              {color}
            </span>
          ))}
          {extraColors > 0 && (
            <span class="text-[11px] font-medium text-gray-400">
              +{extraColors}
            </span>
          )}
        </div>
      )
    }

    <!-- Sizes -->
    {
      visibleSizes.length > 0 && (
        <div class="mt-3 flex flex-wrap items-center gap-1.5">
          {visibleSizes.map((size) => (
            <span class="flex h-7 min-w-[1.75rem] items-center justify-center rounded-md border border-gray-200 px-1.5 text-[11px] font-medium text-gray-600">
              {size}
            </span>
          ))}
          {extraSizes > 0 && (
            <span class="text-[11px] font-medium text-gray-400">
              +{extraSizes}
            </span>
          )}
        </div>
      )
    }

    <div class="relative z-10 mt-4 flex gap-2">
      <a
        href={`/producto/${slug}`}
        data-track="select_item"
        class:list={[
          "flex items-center justify-center rounded-full border border-gray-300 bg-white py-2.5 text-sm font-medium text-gray-700 transition-colors hover:border-gray-900 active:scale-95",
          canQuickAdd ? "flex-1" : "w-full",
        ]}>Ver detalles</a
      >
      {
        canQuickAdd && (
          <button
            type="button"
            data-quick-add
            aria-label={`Agregar ${name} al carrito`}
            class="flex flex-1 items-center justify-center gap-1.5 rounded-full bg-gray-900 py-2.5 text-sm font-medium text-white transition-colors hover:bg-secondary hover:text-plum active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2"
          >
            Agregar
          </button>
        )
      }
    </div>
  </div>
</div>
