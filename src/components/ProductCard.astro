---
import type { PublicProductWithDetails } from "../types/api";
import defaultImg from "../assets/default-product-image.png";

interface Props {
  product: PublicProductWithDetails;
}

const { product } = Astro.props;
const { slug, name, variants, images } = product;

// Extract images
const imageUrls = images.map(img => img.url);
const [mainImage, hoverImage] = imageUrls.length > 0 ? imageUrls : [defaultImg.src, null];

// Extract base price and unique sizes
const basePrice = variants.length > 0 ? Math.min(...variants.map(v => v.price)) : 0;
const uniqueSizes = [...new Set(variants.map(v => v.size).filter(Boolean))];

// Optimization helper
const transformImageUrl = (url: string | null): string => {
  if (!url || url === defaultImg.src) return defaultImg.src;

  // Cloudinary
  if (url.includes("cloudinary.com")) {
    return url.replace("/upload/", "/upload/w_600,h_600,c_fill,f_auto,q_auto/");
  }

  // Supabase
  // if (url.includes("supabase.co") && url.includes("/storage/v1/object/public/")) {
  //   return url.replace("/storage/v1/object/public/", "/storage/v1/render/image/public/") + "?width=600&quality=75";
  // }

  return url;
};

const optimizedMainImage = transformImageUrl(mainImage);
const optimizedHoverImage = hoverImage ? transformImageUrl(hoverImage) : null;
---

<a
  href={`/producto/${slug}`}
  class="group relative block overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:shadow-md"
>
  <div class="relative h-[400px] overflow-hidden">
    <!-- Main Image -->
    <img
      src={optimizedMainImage}
      alt={name}
      class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-0"
    />
    <!-- Hover Image (Second image) -->
    {
      optimizedHoverImage && (
        <img
          src={optimizedHoverImage}
          alt={`${name} - Vista alternativa`}
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      )
    }

    <div
      class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10"
    >
    </div>
  </div>

  <div class="p-5">
    <h3
      class="text-lg font-medium text-gray-900 group-hover:text-secondary transition-colors"
    >
      {name}
    </h3>
    <p class="mt-1 text-gray-500 font-light">{basePrice} Bs</p>

    <!-- Sizes -->
    {uniqueSizes.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {uniqueSizes.map((size) => (
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 text-[10px] text-gray-600 transition-colors">
            {size}
          </span>
        ))}
      </div>
    )}

    <div
      class="mt-4 w-full rounded-lg bg-gray-900 py-3 text-center text-sm font-medium text-white transition-transform active:scale-95 group-hover:bg-secondary"
    >
      Ver Detalles
    </div>
  </div>
</a>
