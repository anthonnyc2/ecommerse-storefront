---
import "../styles/global.css";

import logo from "../assets/r_logo.svg";
import logoText from "../assets/rb_logo_text.svg";
import CartIcon from "../components/CartIcon.astro";
import CartDrawer from "../components/CartDrawer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Catalogo | Raquel Boutique",
  description = "Moda elegante y contemporánea para la mujer moderna. Explora nuestra colección de blusas, vestidos y más.",
  image = logo.src,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://raquelboutique.vercel.app"
);
const socialImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO / Canonical -->
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G7R7X57JM7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-G7R7X57JM7");
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900 font-['Outfit'] antialiased">
    <nav class="bg-white shadow-sm sticky top-0 z-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 justify-between items-center">
          <div class="flex">
            <a href="/" class="flex flex-shrink-0 items-center gap-3">
              <img
                src={logo.src}
                alt="Raquel Boutique Logo"
                class="h-10 w-auto"
              />
              <span
                class="hidden md:block text-xl font-semibold text-gray-900 tracking-tight letter-spacing-[2px]"
                >Raquel Boutique</span
              >
            </a>
          </div>
          <div class="flex space-x-8">
            <a
              href="/"
              class:list={[
                "inline-flex items-center px-1 pt-1 text-sm font-medium hover:text-primary transition-colors",
                Astro.url.pathname === "/" ? "text-gray-900" : "text-gray-500",
              ]}
            >
              Inicio
            </a>
            <a
              href="/catalogo"
              class:list={[
                "inline-flex items-center px-1 pt-1 text-sm font-medium hover:text-primary transition-colors",
                Astro.url.pathname.startsWith("/catalogo")
                  ? "text-gray-900"
                  : "text-gray-500",
              ]}
            >
              Catalogo
            </a>
            <a
              href="/contacto"
              class:list={[
                "inline-flex items-center px-1 pt-1 text-sm font-medium hover:text-primary transition-colors",
                Astro.url.pathname.startsWith("/contacto")
                  ? "text-gray-900"
                  : "text-gray-500",
              ]}
            >
              Contacto
            </a>
          </div>
          <div class="flex items-center">
            <CartIcon />
          </div>
        </div>
      </div>
    </nav>
    <slot />
    <CartDrawer />
  </body>
</html>
