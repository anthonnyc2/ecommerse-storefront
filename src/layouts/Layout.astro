---
import "../styles/global.css";

import logo from "../assets/r_logo.svg";
import CartIcon from "../components/CartIcon.astro";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Catalogo | Raquel Boutique",
  description = "Moda elegante y contemporánea para la mujer moderna. Explora nuestra colección de blusas, vestidos y más.",
  image = logo.src,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://raquel-boutique.com",
);
const socialImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO / Canonical -->
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Preconnect to external origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preconnect"
      href="https://o1090554.ingest.us.sentry.io"
      crossorigin
    />
    <!-- Non-blocking font load: preload + media trick avoids render-blocking -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <!-- Google tag (gtag.js): production only, so dev traffic never reaches GA4 -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          async
          src="https://www.googletagmanager.com/gtag/js?id=G-G7R7X57JM7"
        />
      )
    }
    <script is:inline define:vars={{ enabled: import.meta.env.PROD }}>
      if (enabled) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          // gtag.js only recognises Arguments objects, not arrays
          // eslint-disable-next-line prefer-rest-params
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", "G-G7R7X57JM7");
      }
    </script>
    <script>
      import Clarity from "@microsoft/clarity";
      import {
        initClickTracking,
        initEngagementTracking,
        track,
      } from "../services/analytics";
      // Inline page scripts (define:vars) cannot import modules, so they call window.rbTrack
      window.rbTrack = track;
      initClickTracking();
      initEngagementTracking();
      // Defer Clarity until browser is idle so it doesn't compete with LCP.
      // Production only, so dev sessions never reach the real recordings.
      const initClarity = () =>
        Clarity.init(import.meta.env.PUBLIC_CLARITY_PROJECT_ID);
      if (import.meta.env.PROD) {
        if ("requestIdleCallback" in window) {
          requestIdleCallback(initClarity, { timeout: 3000 });
        } else {
          setTimeout(initClarity, 1000);
        }
      }
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900 font-['Outfit'] antialiased">
    <!-- Skip to main content link for keyboard accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary"
    >
      Saltar al contenido principal
    </a>

    <nav
      class="bg-white shadow-sm sticky top-0 z-50"
      aria-label="Navegación principal"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 justify-between items-center">
          <div class="flex">
            <a href="/" class="flex flex-shrink-0 items-center gap-3">
              <img
                src={logo.src}
                alt="Raquel Boutique Logo"
                class="h-10 w-auto"
              />
              <span
                class="hidden md:block text-xl font-semibold text-gray-900 tracking-tight"
                >Raquel Boutique</span
              >
            </a>
          </div>
          <div class="flex space-x-1">
            {
              (() => {
                const navLinkBase =
                  "inline-flex items-center border-b-2 px-3 pb-0.5 pt-1 text-sm font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2";
                const activeClasses = "border-secondary text-gray-900";
                const inactiveClasses =
                  "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700";
                return (
                  <>
                    <a
                      href="/"
                      aria-current={
                        Astro.url.pathname === "/" ? "page" : undefined
                      }
                      class:list={[
                        navLinkBase,
                        Astro.url.pathname === "/"
                          ? activeClasses
                          : inactiveClasses,
                      ]}
                    >
                      Inicio
                    </a>
                    <a
                      href="/catalogo"
                      aria-current={
                        Astro.url.pathname.startsWith("/catalogo")
                          ? "page"
                          : undefined
                      }
                      class:list={[
                        navLinkBase,
                        Astro.url.pathname.startsWith("/catalogo")
                          ? activeClasses
                          : inactiveClasses,
                      ]}
                    >
                      Catálogo
                    </a>
                    <a
                      href="/contacto"
                      aria-current={
                        Astro.url.pathname.startsWith("/contacto")
                          ? "page"
                          : undefined
                      }
                      class:list={[
                        navLinkBase,
                        Astro.url.pathname.startsWith("/contacto")
                          ? activeClasses
                          : inactiveClasses,
                      ]}
                    >
                      Contacto
                    </a>
                  </>
                );
              })()
            }
          </div>
          <div class="flex items-center">
            <CartIcon />
          </div>
        </div>
      </div>
    </nav>
    <main id="main-content">
      <slot />
    </main>
    <CartDrawer />
    <Footer />
  </body>
</html>
