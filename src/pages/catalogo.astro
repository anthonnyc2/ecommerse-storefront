---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import {
  getCatalogProducts,
  getCatalogFilters,
  getCategories,
  getColors,
} from "../services/api";
import printImg from "../assets/print.png";

// Single source of truth for the catalog page size. The mobile
// infinite-scroll client reads this from `data-page-size` on the grid.
const PAGE_SIZE = 12;

// Get query parameters for filtering
const category = Astro.url.searchParams.get("category") || "";
const color = Astro.url.searchParams.get("color") || "";
const size = Astro.url.searchParams.get("size") || "";
const sort = Astro.url.searchParams.get("sort") || "";
const search = Astro.url.searchParams.get("search") || "";
const page = parseInt(Astro.url.searchParams.get("page") || "1");

// Fetch data from API — 3 parallel requests instead of 4:
// • getCategories()        → { id, name, slug } objects needed for filter UI
// • getColors()            → { id, name, hexCode } objects needed for color swatches
// • getCatalogProducts()   → paginated products
// • getCatalogFilters()    → only called for sizes (string[]), which no other endpoint provides
const [categories, colors, filtersData, { products, total }] =
  await Promise.all([
    getCategories(),
    getColors(),
    getCatalogFilters(),
    getCatalogProducts({
      category,
      color,
      size,
      sort,
      search,
      page,
      limit: PAGE_SIZE,
    }),
  ]);

const { sizes } = filtersData;

// Pagination logic (desktop). Mobile uses infinite scroll and ignores this.
const totalPages = Math.ceil(total / PAGE_SIZE);
---

<Layout title="Catálogo | Raquel Boutique">
  <div class="bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Header -->
      <div class="mb-6">
        <p
          class="mb-1 text-sm font-semibold uppercase tracking-widest text-secondary"
        >
          Raquel Boutique
        </p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
          Catálogo
        </h1>
        <p class="mt-1.5 text-gray-500">Explora nuestra colección completa</p>
      </div>

      <!-- Search bar -->
      <form id="search-form" role="search" class="mb-6 flex items-center gap-2">
        <div class="relative flex-1">
          <div
            class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center"
          >
            <svg
              class="h-4 w-4 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              ></path>
            </svg>
          </div>
          <input
            type="search"
            id="search-input"
            name="search"
            value={search}
            placeholder="Buscar por nombre..."
            aria-label="Buscar productos"
            autocomplete="off"
            class="w-full rounded-full border border-gray-200 bg-white py-2.5 pl-10 pr-4 text-sm text-gray-900 placeholder:text-gray-400 focus:border-secondary focus:outline-none focus:ring-2 focus:ring-secondary/20"
          />
          {
            search && (
              <button
                type="button"
                id="clear-search"
                aria-label="Limpiar búsqueda"
                class="absolute inset-y-0 right-3 flex items-center text-gray-400 hover:text-gray-600"
              >
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </button>
            )
          }
        </div>
        <button
          type="submit"
          class="shrink-0 rounded-full bg-secondary px-5 py-2.5 text-sm font-semibold text-plum hover:bg-secondary/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
        >
          Buscar
        </button>
      </form>

      {
        search && (
          <div class="mb-4 flex items-center gap-2 text-sm text-gray-600">
            <span>
              Resultados para: <strong class="text-gray-900">"{search}"</strong>
            </span>
            <a
              href="/catalogo"
              class="text-secondary hover:underline text-xs font-medium"
            >
              Limpiar
            </a>
          </div>
        )
      }

      <!-- Mobile Toolbar (visible only on mobile) -->
      <div class="lg:hidden mb-6 flex gap-3">
        <!-- Filter Button -->
        <button
          id="mobile-filter-btn"
          aria-label="Abrir filtros"
          class="flex-1 flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
            ></path>
          </svg>
          <span>Filtrar</span>
        </button>

        <!-- Mobile Sort Select -->
        <select
          id="mobile-sort-select"
          aria-label="Ordenar productos"
          class="flex-1 rounded-full border border-gray-200 bg-white py-2.5 pl-3 pr-10 text-sm text-gray-700 focus:border-secondary focus:outline-none focus:ring-1 focus:ring-secondary"
        >
          <option value="">Ordenar por</option>
          <option value="price-asc">Precio: Menor a Mayor</option>
          <option value="price-desc">Precio: Mayor a Menor</option>
          <option value="name-asc">Nombre: A-Z</option>
        </select>
      </div>

      <!-- Mobile Side Menu Overlay -->
      <div
        id="mobile-filter-overlay"
        class="fixed inset-0 bg-black/50 z-40 lg:hidden hidden transition-opacity"
      >
      </div>

      <!-- Mobile Side Menu -->
      <div
        id="mobile-filter-menu"
        class="fixed inset-y-0 left-0 w-80 max-w-[85vw] bg-white z-50 lg:hidden transform -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
      >
        <div class="flex flex-col h-full">
          <!-- Menu Header -->
          <div
            class="flex items-center justify-between p-4 border-b border-gray-200"
          >
            <h2 class="text-lg font-semibold text-gray-900">Filtros</h2>
            <button
              id="mobile-filter-close"
              aria-label="Cerrar filtros"
              class="p-2 rounded-lg hover:bg-gray-100 transition-colors"
            >
              <svg
                class="h-6 w-6 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Menu Content -->
          <div class="flex-1 overflow-y-auto p-4 space-y-6">
            <!-- Categories Filter -->
            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-3">Categorías</h3>
              <div class="space-y-2">
                {
                  categories.map((item) => (
                    <label class="flex items-center cursor-pointer group">
                      <input
                        type="checkbox"
                        value={item.name}
                        checked={
                          category.toLowerCase() === item.name.toLowerCase()
                        }
                        class="category-filter-mobile h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
                      />
                      <span class="ml-3 text-sm text-gray-600 group-hover:text-gray-900">
                        {item.name}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Colors Filter -->
            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-3">Colores</h3>
              <div class="grid grid-cols-4 gap-3">
                {
                  colors.map((item) => {
                    const colorValue = item.hexCode || "#CCCCCC";
                    const isLight = [
                      "blanco",
                      "crema",
                      "amarillo",
                      "blanco",
                      "white",
                    ].includes(item.name.toLowerCase());
                    const isAnimalPrint = item.name.toLowerCase() === "print";
                    return (
                      <label
                        class="cursor-pointer group relative flex flex-col items-center"
                        title={item.name}
                      >
                        <input
                          type="checkbox"
                          value={item.name}
                          checked={
                            color.toLowerCase() === item.name.toLowerCase()
                          }
                          class="color-filter-mobile sr-only peer"
                        />
                        <div
                          class={`w-8 h-8 rounded-full transition-all peer-checked:ring-4 peer-checked:ring-primary peer-checked:ring-offset-2 hover:scale-110 ${
                            isAnimalPrint
                              ? "bg-gradient-to-br from-amber-700 via-amber-600 to-amber-800"
                              : ""
                          }`}
                          style={(() => {
                            if (isAnimalPrint) return "";
                            const border = isLight
                              ? "border: 2px solid #E5E7EB;"
                              : "";
                            return `background-color: ${colorValue}; ${border}`;
                          })()}
                        >
                          {isAnimalPrint && (
                            <div
                              class="w-full h-full rounded-full"
                              style={`background-image: url('${printImg.src}'); background-size: cover;`}
                            />
                          )}
                          <div class="absolute inset-0 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-opacity">
                            <svg
                              class="w-5 h-5 text-white drop-shadow-lg"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          </div>
                        </div>
                        <span class="block text-center text-xs text-gray-600 mt-1 capitalize">
                          {item.name}
                        </span>
                      </label>
                    );
                  })
                }
              </div>
            </div>

            <!-- Sizes Filter -->
            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-3">Tallas</h3>
              <div class="flex flex-wrap gap-2">
                {
                  sizes.map((item: string) => (
                    <label class="cursor-pointer">
                      <input
                        type="checkbox"
                        value={item}
                        checked={size.toLowerCase() === item.toLowerCase()}
                        class="size-filter-mobile sr-only peer"
                      />
                      <span class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-plum transition-colors">
                        {item}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Clear Filters -->
            <button
              id="clear-filters-mobile"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
            >
              Limpiar filtros
            </button>
          </div>

          <!-- Menu Footer -->
          <div class="p-4 border-t border-gray-200">
            <button
              id="apply-filters-mobile"
              class="w-full rounded-full bg-secondary px-4 py-3 text-sm font-semibold text-plum hover:bg-secondary/80 transition-colors"
            >
              Aplicar Filtros
            </button>
          </div>
        </div>
      </div>

      <div class="lg:grid lg:grid-cols-4 lg:gap-x-8">
        <!-- Desktop Filters Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-4 space-y-6">
            <div id="filters-container" class="space-y-6">
              {
                (category || color || size || sort) && (
                  <button
                    id="clear-filters"
                    class="w-full flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      />
                    </svg>
                    Limpiar filtros
                  </button>
                )
              }
              <!-- Sort -->
              <div>
                <h3 class="text-sm font-medium text-gray-900 mb-3">
                  Ordenar por
                </h3>
                <select
                  id="sort-select"
                  aria-label="Ordenar productos"
                  class="w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                >
                  <option value="">Seleccionar</option>
                  <option value="price-asc">Precio: Menor a Mayor</option>
                  <option value="price-desc">Precio: Mayor a Menor</option>
                  <option value="name-asc">Nombre: A-Z</option>
                </select>
              </div>

              <!-- Categories Filter -->
              <div>
                <h3 class="text-sm font-medium text-gray-900 mb-3">
                  Categorías
                </h3>
                <div class="space-y-2">
                  {
                    categories.map((item) => (
                      <label class="flex items-center cursor-pointer group">
                        <input
                          type="checkbox"
                          value={item.name}
                          checked={
                            category.toLowerCase() === item.name.toLowerCase()
                          }
                          class="category-filter h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
                        />
                        <span class="ml-3 text-sm text-gray-600 group-hover:text-gray-900">
                          {item.name}
                        </span>
                      </label>
                    ))
                  }
                </div>
              </div>

              <!-- Colors Filter -->
              <div>
                <h3 class="text-sm font-medium text-gray-900 mb-3">Colores</h3>
                <div class="grid grid-cols-4 gap-3">
                  {
                    colors.map((item) => {
                      const colorValue = item.hexCode || "#CCCCCC";
                      const isLight = [
                        "blanco",
                        "crema",
                        "amarillo",
                        "blanco",
                        "white",
                      ].includes(item.name.toLowerCase());
                      const isAnimalPrint = item.name.toLowerCase() === "print";
                      return (
                        <label
                          class="cursor-pointer group relative flex flex-col items-center"
                          title={item.name}
                        >
                          <input
                            type="checkbox"
                            value={item.name}
                            checked={
                              color.toLowerCase() === item.name.toLowerCase()
                            }
                            class="color-filter sr-only peer"
                          />
                          <div
                            class={`w-8 h-8 rounded-full transition-all peer-checked:ring-4 peer-checked:ring-primary peer-checked:ring-offset-2 hover:scale-110 ${
                              isAnimalPrint
                                ? "bg-gradient-to-br from-amber-700 via-amber-600 to-amber-800"
                                : ""
                            }`}
                            style={(() => {
                              if (isAnimalPrint) return "";
                              const border = isLight
                                ? "border: 2px solid #E5E7EB;"
                                : "";
                              return `background-color: ${colorValue}; ${border}`;
                            })()}
                          >
                            {isAnimalPrint && (
                              <div
                                class="w-full h-full rounded-full"
                                style={`background-image: url('${printImg.src}'); background-size: cover;`}
                              />
                            )}
                            <div class="absolute inset-0 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-opacity">
                              <svg
                                class="w-5 h-5 text-white drop-shadow-lg"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                              >
                                <path
                                  fill-rule="evenodd"
                                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                  clip-rule="evenodd"
                                />
                              </svg>
                            </div>
                          </div>
                          <span class="block text-center text-xs text-gray-600 mt-1 capitalize">
                            {item.name}
                          </span>
                        </label>
                      );
                    })
                  }
                </div>
              </div>

              <!-- Sizes Filter -->
              <div>
                <h3 class="text-sm font-medium text-gray-900 mb-3">Tallas</h3>
                <div class="flex flex-wrap gap-2">
                  {
                    sizes.map((item: string) => (
                      <label class="cursor-pointer">
                        <input
                          type="checkbox"
                          value={item}
                          checked={size.toLowerCase() === item.toLowerCase()}
                          class="size-filter sr-only peer"
                        />
                        <span class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-plum transition-colors">
                          {item}
                        </span>
                      </label>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </aside>

        <!-- Products Grid -->
        <div class="lg:col-span-3">
          <!-- Results count -->
          <div class="mb-6 flex items-center justify-between">
            <p id="results-count" class="text-sm text-gray-600">
              Mostrando {products.length} de {total} productos
            </p>
          </div>

          <!-- Skeleton grid — visible while navigating to new filter results -->
          <div
            id="products-skeleton"
            class="hidden grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
            aria-hidden="true"
          >
            {
              Array.from({ length: 12 }).map(() => (
                <div class="overflow-hidden rounded-xl bg-white shadow-sm">
                  <div class="h-[400px] animate-pulse bg-gray-200" />
                  <div class="p-5 space-y-3">
                    <div class="h-4 animate-pulse rounded bg-gray-200 w-3/4" />
                    <div class="h-3 animate-pulse rounded bg-gray-200 w-1/3" />
                    <div class="mt-4 h-10 animate-pulse rounded-full bg-gray-200" />
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Products Grid -->
          <div
            id="products-grid"
            data-page-size={PAGE_SIZE}
            data-total={total}
            data-list-name={search ? "busqueda" : category || "catalogo"}
            class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          >
            {
              products.map((product, index) => (
                <ProductCard product={product} priority={index === 0} />
              ))
            }
          </div>

          <!-- Infinite scroll (mobile only, ≤1023px). The sentinel below the
               grid is observed by the client script which auto-fetches the
               next page when the user nears the bottom. -->
          <div id="infinite-scroll-region" class="mt-8 lg:hidden">
            <div
              id="infinite-scroll-sentinel"
              class="h-1 w-full"
              aria-hidden="true"
            >
            </div>

            <div
              id="infinite-scroll-loading"
              class="hidden py-8 text-center"
              role="status"
              aria-live="polite"
            >
              <div
                class="motion-safe:animate-spin motion-reduce:animate-none mx-auto h-6 w-6 rounded-full border-2 border-gray-200 border-t-secondary"
                aria-hidden="true"
              >
              </div>
              <p class="mt-2 text-sm text-gray-500">
                Cargando más productos...
              </p>
            </div>

            <p
              id="infinite-scroll-end-message"
              class="hidden py-8 text-center text-sm text-gray-500"
            >
              Has visto todos los productos
            </p>

            <div
              id="infinite-scroll-error"
              class="hidden py-6 text-center"
              role="alert"
            >
              <p class="text-sm text-gray-600">
                No pudimos cargar más productos.
              </p>
              <button
                type="button"
                id="infinite-scroll-retry"
                class="mt-2 inline-flex items-center rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
              >
                Reintentar
              </button>
            </div>

            <div
              id="infinite-scroll-announcer"
              class="sr-only"
              aria-live="polite"
              aria-atomic="true"
            >
            </div>
          </div>

          <!-- Pagination (desktop ≥1024px). Mobile hides via lg:flex. -->
          {
            totalPages > 1 && (
              <nav
                id="pagination"
                class="mt-12 hidden items-center justify-center gap-3 lg:flex"
                aria-label="Paginación"
              >
                <button
                  id="pagination-prev"
                  type="button"
                  aria-label="Página anterior"
                  disabled={page <= 1}
                  class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white"
                >
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15.75 19.5L8.25 12l7.5-7.5"
                    />
                  </svg>
                  <span>Anterior</span>
                </button>

                <span class="text-sm text-gray-600" aria-live="polite">
                  Página{" "}
                  <strong class="font-semibold text-gray-900">{page}</strong> de{" "}
                  <strong class="font-semibold text-gray-900">
                    {totalPages}
                  </strong>
                </span>

                <button
                  id="pagination-next"
                  type="button"
                  aria-label="Página siguiente"
                  disabled={page >= totalPages}
                  class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white"
                >
                  <span>Siguiente</span>
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8.25 4.5l7.5 7.5-7.5 7.5"
                    />
                  </svg>
                </button>
              </nav>
            )
          }

          <!-- No results message -->
          <div
            id="no-results"
            class={products.length === 0
              ? "text-center py-12"
              : "hidden text-center py-12"}
          >
            <svg
              class="mx-auto h-12 w-12 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">
              No se encontraron productos
            </h3>
            <p class="mt-1 text-sm text-gray-500">
              Intenta ajustar los filtros
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating "back to top" button. Hidden by default (opacity-0,
       pointer-events-none); the client script reveals it only when the
       user has loaded extra pages (page > 1) AND is scrolling upward. -->
  <button
    id="back-to-top"
    type="button"
    aria-label="Volver al inicio de la página"
    class="fixed bottom-6 right-6 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-gray-200 bg-white/90 text-gray-600 opacity-0 shadow-sm backdrop-blur pointer-events-none transition-opacity duration-200 hover:bg-white hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
  >
    <svg
      class="h-5 w-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
    </svg>
  </button>

  <script>
    import { actions } from "astro:actions";
    import {
      trackCatalogView,
      trackPageLoaded,
    } from "../services/catalogAnalytics";

    document.addEventListener("DOMContentLoaded", () => {
      trackCatalogView();

      // Show skeleton grid while navigating to new results
      function showSkeleton() {
        document.getElementById("products-grid")?.classList.add("hidden");
        document
          .getElementById("products-skeleton")
          ?.classList.remove("hidden");
      }

      // Helper to update URL and redirect
      function updateFilters(params: Record<string, string>) {
        const url = new URL(window.location.href);
        Object.entries(params).forEach(([key, value]) => {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        });
        // When changing filters, always reset to page 1
        if (!params.page) url.searchParams.delete("page");

        showSkeleton();
        window.location.href = url.toString();
      }

      // Filter elements
      const filters = [
        { selector: ".category-filter", param: "category" },
        { selector: ".color-filter", param: "color" },
        { selector: ".size-filter", param: "size" },
        { selector: ".category-filter-mobile", param: "category" },
        { selector: ".color-filter-mobile", param: "color" },
        { selector: ".size-filter-mobile", param: "size" },
      ];

      filters.forEach(({ selector, param }) => {
        document.querySelectorAll(selector).forEach((el) => {
          el.addEventListener("change", (e) => {
            const checked = (e.target as HTMLInputElement).checked;
            updateFilters({
              [param]: checked ? (e.target as HTMLInputElement).value : "",
            });
          });
        });
      });

      // Sort selectors
      const sortSelects = ["#sort-select", "#mobile-sort-select"];
      sortSelects.forEach((selector) => {
        const el = document.querySelector(selector) as HTMLSelectElement;
        if (el) {
          el.addEventListener("change", () => {
            updateFilters({ sort: el.value });
          });
          // Set initial value from URL
          const currentSort = new URLSearchParams(window.location.search).get(
            "sort",
          );
          if (currentSort) el.value = currentSort;
        }
      });

      // Pagination
      const prevBtn = document.getElementById("pagination-prev");
      const nextBtn = document.getElementById("pagination-next");
      const currentPageFromUrl = Math.max(
        1,
        Number.parseInt(
          new URLSearchParams(window.location.search).get("page") ?? "1",
          10,
        ) || 1,
      );
      prevBtn?.addEventListener("click", () => {
        if (!prevBtn.hasAttribute("disabled")) {
          updateFilters({ page: String(currentPageFromUrl - 1) });
        }
      });
      nextBtn?.addEventListener("click", () => {
        if (!nextBtn.hasAttribute("disabled")) {
          updateFilters({ page: String(currentPageFromUrl + 1) });
        }
      });

      // Clear filters (preserves search term)
      const clearBtn = document.getElementById("clear-filters");
      const clearBtnMobile = document.getElementById("clear-filters-mobile");
      [clearBtn, clearBtnMobile].forEach((btn) => {
        btn?.addEventListener("click", () => {
          const currentSearch = new URLSearchParams(window.location.search).get(
            "search",
          );
          showSkeleton();
          window.location.href = currentSearch
            ? `/catalogo?search=${encodeURIComponent(currentSearch)}`
            : "/catalogo";
        });
      });

      // Search form
      const searchForm = document.getElementById(
        "search-form",
      ) as HTMLFormElement | null;
      const clearSearch = document.getElementById("clear-search");

      searchForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById(
          "search-input",
        ) as HTMLInputElement;
        updateFilters({ search: input.value.trim() });
      });

      clearSearch?.addEventListener("click", () => {
        updateFilters({ search: "" });
      });

      // Mobile menu toggle logic
      const mobileFilterBtn = document.getElementById("mobile-filter-btn");
      const mobileFilterMenu = document.getElementById("mobile-filter-menu");
      const mobileFilterOverlay = document.getElementById(
        "mobile-filter-overlay",
      );
      const mobileFilterClose = document.getElementById("mobile-filter-close");

      mobileFilterBtn?.addEventListener("click", () => {
        mobileFilterMenu?.classList.remove("-translate-x-full");
        mobileFilterOverlay?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      });

      const closeMenu = () => {
        mobileFilterMenu?.classList.add("-translate-x-full");
        mobileFilterOverlay?.classList.add("hidden");
        document.body.style.overflow = "";
      };

      mobileFilterClose?.addEventListener("click", closeMenu);
      mobileFilterOverlay?.addEventListener("click", closeMenu);

      // ---------- Infinite scroll (mobile only, ≤1023px) ----------
      // Each guard below is independent — a missing optional element
      // (e.g. the pagination nav when totalPages === 1) does not
      // disable the rest of the behaviour.
      const grid = document.getElementById(
        "products-grid",
      ) as HTMLElement | null;
      const sentinel = document.getElementById(
        "infinite-scroll-sentinel",
      ) as HTMLElement | null;
      const loadingEl = document.getElementById(
        "infinite-scroll-loading",
      ) as HTMLElement | null;
      const endEl = document.getElementById(
        "infinite-scroll-end-message",
      ) as HTMLElement | null;
      const errorEl = document.getElementById(
        "infinite-scroll-error",
      ) as HTMLElement | null;
      const retryBtn = document.getElementById(
        "infinite-scroll-retry",
      ) as HTMLButtonElement | null;
      const announcerEl = document.getElementById(
        "infinite-scroll-announcer",
      ) as HTMLElement | null;
      const paginationEl = document.getElementById(
        "pagination",
      ) as HTMLElement | null;
      const resultsCountEl = document.getElementById(
        "results-count",
      ) as HTMLElement | null;

      if (grid && sentinel && loadingEl && endEl && errorEl && announcerEl) {
        const pageSize = Number(grid.dataset.pageSize ?? "12");
        const totalProducts = Number(grid.dataset.total ?? "0");
        const urlParams = new URLSearchParams(window.location.search);
        let currentPage = Math.max(
          1,
          Number.parseInt(urlParams.get("page") ?? "1", 10) || 1,
        );
        let isLoading = false;
        let hasMore = currentPage * pageSize < totalProducts;

        const observer = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (entry?.isIntersecting) loadNextPage();
          },
          { rootMargin: "400px 0px 400px 0px" },
        );
        observer.observe(sentinel);

        function toggle(el: HTMLElement | null, on: boolean) {
          el?.classList.toggle("hidden", !on);
        }

        function announce(message: string) {
          // eslint-disable-next-line sonarjs/no-gratuitous-expressions -- TS does not narrow captured consts inside function declarations
          if (announcerEl) announcerEl.textContent = message;
        }

        function updateResultsCount() {
          // eslint-disable-next-line sonarjs/no-gratuitous-expressions -- TS does not narrow captured consts inside function declarations
          if (!resultsCountEl || !grid) return;
          const shown = grid.querySelectorAll(":scope > a").length;
          resultsCountEl.textContent = `Mostrando ${shown} de ${totalProducts} productos`;
        }

        function pushPageToHistory(page: number) {
          const url = new URL(window.location.href);
          url.searchParams.set("page", String(page));
          window.history.pushState({ page }, "", url.toString());
        }

        function endOfResults() {
          hasMore = false;
          toggle(loadingEl, false);
          toggle(endEl, true);
          toggle(errorEl, false);
          announce("Has visto todos los productos");
          observer.disconnect();
          isLoading = false;
        }

        function showError() {
          toggle(loadingEl, false);
          toggle(errorEl, true);
          announce("No pudimos cargar más productos. Pulsa Reintentar.");
          isLoading = false;
        }

        function applyPage(
          html: string,
          count: number,
          total: number,
          nextPage: number,
        ) {
          // eslint-disable-next-line sonarjs/no-gratuitous-expressions -- TS does not narrow captured consts inside function declarations
          if (!grid) return;
          grid.insertAdjacentHTML("beforeend", html);
          currentPage = nextPage;
          pushPageToHistory(nextPage);
          trackPageLoaded(nextPage, grid.dataset.listName ?? "catalogo");
          updateResultsCount();
          announce(`${count} productos más cargados`);
          toggle(loadingEl, false);
          hasMore = currentPage * pageSize < total;
          if (!hasMore) {
            toggle(endEl, true);
            announce("Has visto todos los productos");
            observer.disconnect();
          }
          isLoading = false;
        }

        async function loadNextPage() {
          if (isLoading || !hasMore) return;
          const nextPage = currentPage + 1;
          isLoading = true;
          toggle(errorEl, false);
          toggle(loadingEl, true);
          announce(`Cargando página ${nextPage}`);

          const result = await actions.loadMoreCatalog({
            page: nextPage,
            limit: pageSize,
            category: urlParams.get("category") ?? "",
            color: urlParams.get("color") ?? "",
            size: urlParams.get("size") ?? "",
            sort: urlParams.get("sort") ?? "",
            search: urlParams.get("search") ?? "",
          });

          if (result.error || !result.data) {
            console.error("[infinite-scroll] action failed", result.error);
            showError();
            return;
          }
          const { html, total, count } = result.data;
          if (count === 0 || !html) {
            endOfResults();
            return;
          }
          applyPage(html, count, total, nextPage);
        }

        retryBtn?.addEventListener("click", () => {
          toggle(errorEl, false);
          loadNextPage();
        });

        // ---------- Back-to-top floating button ----------
        // Visible only when the user has loaded at least one extra page
        // AND is scrolling upward AND has scrolled past the first fold.
        const backToTopBtn = document.getElementById(
          "back-to-top",
        ) as HTMLButtonElement | null;
        if (backToTopBtn) {
          const SHOW_THRESHOLD = 400;
          let lastScrollY = window.scrollY;
          let scrollingUp = false;

          function updateBackToTop() {
            // eslint-disable-next-line sonarjs/no-gratuitous-expressions -- TS does not narrow captured consts inside function declarations
            if (!backToTopBtn) return;
            const shouldShow =
              currentPage > 1 && scrollingUp && window.scrollY > SHOW_THRESHOLD;
            backToTopBtn.classList.toggle("opacity-0", !shouldShow);
            backToTopBtn.classList.toggle("pointer-events-none", !shouldShow);
          }

          window.addEventListener(
            "scroll",
            () => {
              const currentY = window.scrollY;
              scrollingUp = currentY < lastScrollY;
              lastScrollY = currentY;
              updateBackToTop();
            },
            { passive: true },
          );

          backToTopBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });

          updateBackToTop();
        }

        // Pagination visibility + reload on breakpoint cross (best-effort;
        // works whether or not the nav is in the DOM).
        const MOBILE_MQ = window.matchMedia("(max-width: 1023px)");
        if (paginationEl) {
          paginationEl.classList.toggle("hidden", MOBILE_MQ.matches);
          paginationEl.setAttribute(
            "aria-hidden",
            MOBILE_MQ.matches ? "true" : "false",
          );
        }
        MOBILE_MQ.addEventListener("change", () => {
          window.location.reload();
        });

        if (totalProducts === 0) {
          observer.disconnect();
        } else if (!hasMore) {
          toggle(endEl, true);
        }
      }
    });
  </script>
</Layout>
