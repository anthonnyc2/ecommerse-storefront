---
import { getProductBySlug, getColors } from "../../services/api";
import defaultImg from "../../assets/default-product-image.png";
import printImg from "../../assets/print.png";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const [product, allColors] = await Promise.all([
  getProductBySlug(slug),
  getColors(),
]);

if (!product) {
  return Astro.redirect("/404");
}

const { name, variants, images, description, category, brand } = product;

// Extract images
const mainImage = images.length > 0 ? images[0].url : defaultImg.src;

// Extract base price and unique sizes/colors
const basePrice =
  variants.length > 0 ? Math.min(...variants.map((v) => v.price)) : 0;
const uniqueSizes = [...new Set(variants.map((v) => v.size).filter(Boolean))];
const uniqueColors = [...new Set(variants.map((v) => v.color).filter(Boolean))];

// Dynamic color mapping
const getColorHex = (colorName: string) => {
  const colorObj = allColors.find(
    (c) => c.name.toLowerCase() === colorName.toLowerCase(),
  );
  return colorObj?.hexCode || "#CCCCCC";
};

// Optimization helper
const transformImageUrl = (url: string, width = 800): string => {
  if (!url || url === defaultImg.src) return url;

  // Cloudinary
  if (url.includes("cloudinary.com")) {
    return url.replace("/upload/", `/upload/w_${width},f_auto,q_auto/`);
  }

  // Supabase
  if (
    url.includes("supabase.co") &&
    url.includes("/storage/v1/object/public/")
  ) {
    const baseUrl = url.replace(
      "/storage/v1/object/public/",
      "/storage/v1/render/image/public/",
    );
    return `${baseUrl}?width=${width}&quality=80`;
  }

  return url;
};

const socialImage = transformImageUrl(mainImage, 1200);
const socialDescription = description || `Compra ${name} en Raquel Boutique.`;
---

<Layout
  title={`${name} | Raquel Boutique`}
  description={socialDescription}
  image={socialImage}
>
  <div class="bg-white">
    <div class="pt-6 pb-16 sm:pb-24">
      <!-- Breadcrumb -->
      <nav
        aria-label="Breadcrumb"
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
      >
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <div class="flex items-center">
              <a
                href="/"
                class="mr-4 text-sm font-medium text-gray-900 hover:text-primary"
                >Inicio</a
              >
              <svg
                viewBox="0 0 6 20"
                aria-hidden="true"
                class="h-5 w-auto text-gray-300"
              >
                <path
                  d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z"
                  fill="currentColor"></path>
              </svg>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <a
                href={`/catalogo?category=${encodeURIComponent(category || "")}`}
                class="mr-4 text-sm font-medium text-gray-900 hover:text-primary"
                >{category}</a
              >
              <svg
                viewBox="0 0 6 20"
                aria-hidden="true"
                class="h-5 w-auto text-gray-300"
              >
                <path
                  d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z"
                  fill="currentColor"></path>
              </svg>
            </div>
          </li>
          <li class="text-sm">
            <span class="font-medium text-gray-500">{name}</span>
          </li>
        </ol>
      </nav>

      <div class="mx-auto mt-8 max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8">
          <!-- Image gallery -->
          <div class="flex flex-col-reverse">
            <!-- Image selector -->
            {
              images.length > 1 && (
                <div class="mx-auto mt-6 w-full max-w-2xl lg:max-w-none">
                  <div
                    class="grid grid-cols-4 gap-3 sm:gap-6"
                    id="thumbnails-grid"
                    role="tablist"
                  >
                    {images.map((img, index) => (
                      <button
                        class={`thumb-btn relative flex h-24 cursor-pointer items-center justify-center rounded-md bg-white text-sm font-medium uppercase hover:bg-gray-50 focus:outline-none focus:ring focus:ring-opacity-50 focus:ring-offset-2 
                      ${index === 0 ? "ring-2 ring-secondary" : ""}`}
                        data-full={transformImageUrl(img.url, 800)}
                        data-color={img.color || ""}
                      >
                        <span class="absolute inset-0 overflow-hidden rounded-md">
                          <img
                            src={transformImageUrl(img.url, 150)}
                            alt=""
                            class="h-full w-full object-cover object-center"
                          />
                        </span>
                      </button>
                    ))}
                  </div>
                </div>
              )
            }

            <div
              class="w-full max-h-[600px] flex items-center justify-center overflow-hidden rounded-lg bg-gray-50"
              id="main-image-container"
            >
              <img
                id="main-product-image"
                src={transformImageUrl(mainImage, 800)}
                alt={name}
                class="h-full w-full object-contain transition-transform duration-300 hover:scale-110 cursor-zoom-in"
              />
            </div>
          </div>

          <!-- Product info -->
          <div class="mt-10 px-4 sm:mt-16 sm:px-0 lg:mt-0">
            <div class="flex justify-between items-start">
              <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                  {name}
                </h1>
                <p class="mt-1 text-sm text-gray-500 uppercase tracking-wide">
                  {brand}
                </p>
              </div>
              <p class="text-3xl font-semibold text-gray-900">{basePrice} Bs</p>
            </div>

            <div class="mt-6">
              <h3 class="sr-only">Descripción</h3>
              <div class="space-y-6 text-base text-gray-700">
                <p>{description || "Sin descripción disponible."}</p>
              </div>
            </div>

            {
              uniqueColors.length > 0 && (
                <div class="mt-8">
                  <h3 class="text-sm font-medium text-gray-900">Color</h3>
                  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
                    {uniqueColors.map((colorAttr) => {
                      const color = colorAttr as string;
                      const colorValue = getColorHex(color);
                      const isLight = [
                        "blanco",
                        "crema",
                        "amarillo",
                        "white",
                        "blanco",
                      ].includes(color.toLowerCase());
                      const isAnimalPrint = color.toLowerCase() === "print";

                      let colorStyle = "";
                      if (!isAnimalPrint) {
                        colorStyle = `background-color: ${colorValue};`;
                        if (isLight) {
                          colorStyle += " border: 1px solid #E5E7EB;";
                        }
                      }

                      return (
                        <button
                          type="button"
                          class="color-option flex items-center gap-3 rounded-xl border-2 py-3 px-4 text-sm font-medium transition-all hover:bg-gray-50 focus:outline-none border-gray-100 bg-gray-50/50"
                          data-color={color}
                        >
                          <div
                            class={`h-4 w-4 rounded-full border border-black/10 shrink-0 ${isAnimalPrint ? "bg-gradient-to-br from-amber-700 via-amber-600 to-amber-800" : ""}`}
                            style={colorStyle}
                          >
                            {isAnimalPrint && (
                              <div
                                class="w-full h-full rounded-full"
                                style={`background-image: url('${printImg.src}'); background-size: cover;`}
                              />
                            )}
                          </div>
                          <span class="truncate capitalize">{color}</span>
                        </button>
                      );
                    })}
                  </div>
                </div>
              )
            }

            {
              uniqueSizes.length > 0 && (
                <div class="mt-8">
                  <h3 class="text-sm font-medium text-gray-900">Talla</h3>
                  <div class="mt-3 grid grid-cols-4 gap-3">
                    {uniqueSizes.map((size) => (
                      <button
                        type="button"
                        class="size-option flex items-center justify-center rounded-md border py-3 px-3 text-sm font-medium uppercase hover:bg-gray-50 focus:outline-none transition-all border-gray-300"
                        data-size={size}
                      >
                        {size}
                      </button>
                    ))}
                  </div>
                </div>
              )
            }

            <!-- Stock indicator -->
            <div id="stock-indicator" class="mt-4 hidden">
              <p class="text-sm font-medium text-gray-900">
                Disponibilidad: <span
                  id="stock-value"
                  class="text-secondary font-bold"></span>
              </p>
            </div>

            <div class="mt-10 flex flex-col gap-4">
              <button
                type="button"
                id="add-to-cart-btn"
                class="flex w-full items-center justify-center gap-3 rounded-xl border-2 border-gray-900 bg-white px-8 py-4 text-lg font-bold text-gray-900 shadow-sm hover:border-secondary hover:text-secondary transition-all active:scale-95"
              >
                <svg
                  class="h-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                  ></path>
                </svg>
                Añadir al Carrito
              </button>

              <button
                type="button"
                id="buy-now-btn"
                class="flex w-full items-center justify-center gap-3 rounded-xl bg-gray-900 px-8 py-4 text-lg font-bold text-white shadow-lg hover:bg-secondary transition-all active:scale-95"
              >
                Comprar Ahora
              </button>

              <p class="mt-2 text-center text-xs text-gray-500">
                Selecciona tu talla y color para añadir al pedido.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pass data to script -->
  <script is:inline define:vars={{ variants }}>
    window.productVariants = variants;
  </script>

  <script>
    import Clarity from "@microsoft/clarity";
    import { addItem } from "../../services/cartStore";

    interface ProductVariant {
      id: string;
      productId: string;
      productSlug: string;
      name: string;
      price: number;
      size: string;
      color: string;
      stock: number;
      image?: string;
    }

    const CLASSES = {
      BORDER_SECONDARY: "border-secondary",
      BG_SECONDARY_10: "bg-secondary/10",
      BG_SECONDARY_5: "bg-secondary/5",
      TEXT_SECONDARY: "text-secondary",
      RING_SECONDARY: "ring-secondary",
      RING_2: "ring-2",
      BORDER_GRAY_300: "border-gray-300",
    };

    const DATA_ATTRS = {
      COLOR: "data-color",
      SIZE: "data-size",
      FULL: "data-full",
    };

    document.addEventListener("DOMContentLoaded", () => {
      Clarity.event("ViewProduct");
      const mainImg = document.getElementById(
        "main-product-image",
      ) as HTMLImageElement | null;
      const thumbBtns = document.querySelectorAll<HTMLElement>(".thumb-btn");
      const sizeBtns = document.querySelectorAll<HTMLElement>(".size-option");
      const colorBtns = document.querySelectorAll<HTMLElement>(".color-option");
      const stockIndicator = document.getElementById("stock-indicator");
      const stockValue = document.getElementById("stock-value");

      // @ts-expect-error - Product variants are passed via define:vars
      const variants: ProductVariant[] = window.productVariants || [];
      let selectedSize = "";
      let selectedColor = "";

      function updateStockDisplay() {
        if (!selectedSize || !selectedColor || !stockIndicator || !stockValue) {
          stockIndicator?.classList.add("hidden");
          return;
        }

        const variant = variants.find(
          (v: ProductVariant) =>
            v.size?.toLowerCase() === selectedSize.toLowerCase() &&
            v.color?.toLowerCase() === selectedColor.toLowerCase(),
        );

        if (variant) {
          stockIndicator.classList.remove("hidden");
          stockValue.textContent = variant.stock > 0 ? "En stock" : "Agotado";
        } else {
          stockIndicator.classList.add("hidden");
        }
      }

      function updateSizeAvailability() {
        if (!selectedColor) return;

        const availableSizes = variants
          .filter(
            (v: ProductVariant) =>
              v.color?.toLowerCase() === selectedColor.toLowerCase() &&
              v.stock > 0,
          )
          .map((v: ProductVariant) => v.size?.toLowerCase());

        sizeBtns.forEach((btn) => {
          const btnSize = btn.getAttribute(DATA_ATTRS.SIZE)?.toLowerCase();
          if (btnSize && availableSizes.includes(btnSize)) {
            btn.classList.remove(
              "opacity-20",
              "cursor-not-allowed",
              "pointer-events-none",
            );
            btn.classList.add("opacity-100", "cursor-pointer");
          } else {
            btn.classList.add(
              "opacity-20",
              "cursor-not-allowed",
              "pointer-events-none",
            );
            btn.classList.remove("opacity-100", "cursor-pointer");
            btn.classList.remove(
              CLASSES.BORDER_SECONDARY,
              CLASSES.BG_SECONDARY_10,
              CLASSES.TEXT_SECONDARY,
            );
            btn.classList.add(CLASSES.BORDER_GRAY_300);
          }
        });
      }

      // Image switching
      thumbBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const newUrl = btn.getAttribute(DATA_ATTRS.FULL);
          if (mainImg && newUrl) mainImg.src = newUrl;

          thumbBtns.forEach((b) =>
            b.classList.remove(CLASSES.RING_2, CLASSES.RING_SECONDARY),
          );
          btn.classList.add(CLASSES.RING_2, CLASSES.RING_SECONDARY);
        });
      });

      // Color selection
      colorBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedColor = btn.getAttribute(DATA_ATTRS.COLOR) || "";

          // Update button styles
          colorBtns.forEach((b) => {
            b.classList.remove(
              CLASSES.BORDER_SECONDARY,
              CLASSES.BG_SECONDARY_5,
              CLASSES.TEXT_SECONDARY,
              "shadow-sm",
            );
            b.classList.add("border-gray-100", "bg-gray-50/50");
          });
          btn.classList.remove("border-gray-100", "bg-gray-50/50");
          btn.classList.add(
            CLASSES.BORDER_SECONDARY,
            CLASSES.BG_SECONDARY_5,
            CLASSES.TEXT_SECONDARY,
            "shadow-sm",
          );

          // Filter thumbnails
          const formattedSelectedColor = selectedColor.toLowerCase();
          let firstVisibleThumb: HTMLElement | null = null;
          let currentMainStillVisible = false;

          for (const thumb of Array.from(thumbBtns)) {
            const thumbColor = (
              thumb.getAttribute(DATA_ATTRS.COLOR) || ""
            ).toLowerCase();
            const isVisible =
              !thumbColor || thumbColor === formattedSelectedColor;

            if (isVisible) {
              thumb.style.display = "flex";
              if (!firstVisibleThumb) firstVisibleThumb = thumb as HTMLElement;
              if (
                mainImg &&
                thumb.getAttribute(DATA_ATTRS.FULL) === mainImg.src
              ) {
                currentMainStillVisible = true;
              }
            } else {
              thumb.style.display = "none";
            }
          }

          // Update main image if current one is hidden
          if (!currentMainStillVisible && firstVisibleThumb && mainImg) {
            const thumbElement = firstVisibleThumb as HTMLElement;
            const newUrl = thumbElement.getAttribute(DATA_ATTRS.FULL);
            if (newUrl) {
              mainImg.src = newUrl;
              thumbBtns.forEach((b: HTMLElement) =>
                b.classList.remove(CLASSES.RING_2, CLASSES.RING_SECONDARY),
              );
              thumbElement.classList.add(
                CLASSES.RING_2,
                CLASSES.RING_SECONDARY,
              );
            }
          }

          updateSizeAvailability();
          updateStockDisplay();
        });
      });

      // Size selection
      sizeBtns.forEach((btn: HTMLElement) => {
        btn.addEventListener("click", () => {
          selectedSize = btn.getAttribute(DATA_ATTRS.SIZE) || "";
          sizeBtns.forEach((b: HTMLElement) => {
            b.classList.remove(
              CLASSES.BORDER_SECONDARY,
              CLASSES.BG_SECONDARY_10,
              CLASSES.TEXT_SECONDARY,
            );
            b.classList.add(CLASSES.BORDER_GRAY_300);
          });
          btn.classList.remove(CLASSES.BORDER_GRAY_300);
          btn.classList.add(
            CLASSES.BORDER_SECONDARY,
            CLASSES.BG_SECONDARY_10,
            CLASSES.TEXT_SECONDARY,
          );

          updateStockDisplay();
        });
      });

      // Cart logic
      function getProductData() {
        if (!selectedSize && sizeBtns.length > 0) {
          alert("Por favor selecciona una talla");
          return null;
        }
        if (!selectedColor && colorBtns.length > 0) {
          alert("Por favor selecciona un color");
          return null;
        }

        const variant = variants.find(
          (v: ProductVariant) =>
            v.size?.toLowerCase() === selectedSize.toLowerCase() &&
            v.color?.toLowerCase() === selectedColor.toLowerCase(),
        );

        return {
          id:
            variant?.id ||
            `${variants[0].productId}-${selectedColor}-${selectedSize}`,
          slug:
            variants[0].productSlug ||
            window.location.pathname.split("/").pop() ||
            "",
          name: document.querySelector("h1")?.textContent || "Producto",
          price: variant?.price || variants[0].price,
          image: mainImg?.src || "",
          size: selectedSize,
          color: selectedColor,
          brand:
            document.querySelector("p.mt-1.text-sm.text-gray-500.uppercase")
              ?.textContent || "",
        };
      }

      document
        .getElementById("add-to-cart-btn")
        ?.addEventListener("click", () => {
          const productData = getProductData();
          if (productData) {
            Clarity.event("AddToCart");
            addItem(productData);
            const btn = document.getElementById("add-to-cart-btn");
            if (btn) {
              const originalText = btn.innerHTML;
              btn.innerHTML = "¡Añadido!";
              btn.classList.add(
                "bg-green-50",
                "border-green-500",
                "text-green-600",
              );
              setTimeout(() => {
                btn.innerHTML = originalText;
                btn.classList.remove(
                  "bg-green-50",
                  "border-green-500",
                  "text-green-600",
                );
              }, 1000);
            }
          }
        });

      document.getElementById("buy-now-btn")?.addEventListener("click", () => {
        const productData = getProductData();
        if (productData) {
          Clarity.event("AddToCart");
          addItem(productData);
          window.dispatchEvent(new CustomEvent("toggle-cart"));
        }
      });

      // Auto-select unique options
      if (colorBtns.length === 1) {
        colorBtns[0].click();
      }
      if (sizeBtns.length === 1) {
        sizeBtns[0].click();
      }
    });
  </script>
</Layout>
