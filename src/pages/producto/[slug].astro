---
import { getProductBySlug, getColors, getCategories } from "../../services/api";
import defaultImg from "../../assets/default-product-image.png";
import printImg from "../../assets/print.png";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const [product, allColors, allCategories] = await Promise.all([
  getProductBySlug(slug),
  getColors(),
  getCategories()
]);

if (!product) {
  return Astro.redirect("/404");
}

const { name, variants, images, description, category, brand } = product;

// Extract images
const mainImage = images.length > 0 ? images[0].url : defaultImg.src;

// Extract base price and unique sizes/colors
const basePrice = variants.length > 0 ? Math.min(...variants.map(v => v.price)) : 0;
const uniqueSizes = [...new Set(variants.map(v => v.size).filter(Boolean))];
const uniqueColors = [...new Set(variants.map(v => v.color).filter(Boolean))];

// Dynamic color mapping
const getColorHex = (colorName: string) => {
  const colorObj = allColors.find(c => c.name.toLowerCase() === colorName.toLowerCase());
  return colorObj?.hexCode || "#CCCCCC";
};

// Optimization helper
const transformImageUrl = (url: string, width = 800): string => {
  if (!url || url === defaultImg.src) return url;
  
  // Cloudinary
  if (url.includes("cloudinary.com")) {
    return url.replace("/upload/", `/upload/w_${width},f_auto,q_auto/`);
  }

  // Supabase
  // if (url.includes("supabase.co") && url.includes("/storage/v1/object/public/")) {
  //   const baseUrl = url.replace("/storage/v1/object/public/", "/storage/v1/render/image/public/");
  //   return `${baseUrl}?width=${width}&quality=80`;
  // }

  return url;
};

const socialImage = transformImageUrl(mainImage, 1200);
const socialDescription = description || `Compra ${name} en Raquel Boutique.`;
---

<Layout
  title={`${name} | Raquel Boutique`}
  description={socialDescription}
  image={socialImage}
>
  <div class="bg-white">
    <div class="pt-6 pb-16 sm:pb-24">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <div class="flex items-center">
              <a href="/" class="mr-4 text-sm font-medium text-gray-900 hover:text-primary">Inicio</a>
              <svg viewBox="0 0 6 20" aria-hidden="true" class="h-5 w-auto text-gray-300">
                <path d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z" fill="currentColor"></path>
              </svg>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <a href={`/catalogo?category=${encodeURIComponent(category || "")}`} class="mr-4 text-sm font-medium text-gray-900 hover:text-primary">{category}</a>
              <svg viewBox="0 0 6 20" aria-hidden="true" class="h-5 w-auto text-gray-300">
                <path d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z" fill="currentColor"></path>
              </svg>
            </div>
          </li>
          <li class="text-sm">
            <span class="font-medium text-gray-500">{name}</span>
          </li>
        </ol>
      </nav>

      <div class="mx-auto mt-8 max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8">
          <!-- Image gallery -->
          <div class="flex flex-col-reverse">
            <!-- Image selector -->
            {images.length > 1 && (
              <div class="mx-auto mt-6 w-full max-w-2xl lg:max-w-none">
                <div class="grid grid-cols-4 gap-3 sm:gap-6" id="thumbnails-grid" role="tablist">
                  {images.map((img, index) => (
                    <button
                      class={`thumb-btn relative flex h-24 cursor-pointer items-center justify-center rounded-md bg-white text-sm font-medium uppercase hover:bg-gray-50 focus:outline-none focus:ring focus:ring-opacity-50 focus:ring-offset-2 
                      ${index === 0 ? "ring-2 ring-secondary" : ""}`}
                      data-full={transformImageUrl(img.url, 800)}
                      data-color={img.color || ""}
                    >
                      <span class="absolute inset-0 overflow-hidden rounded-md">
                        <img src={transformImageUrl(img.url, 150)} alt="" class="h-full w-full object-cover object-center" />
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            <div class="w-full max-h-[600px] flex items-center justify-center overflow-hidden rounded-lg bg-gray-50" id="main-image-container">
              <img
                id="main-product-image"
                src={transformImageUrl(mainImage, 800)}
                alt={name}
                class="h-full w-full object-contain transition-transform duration-300 hover:scale-110 cursor-zoom-in"
              />
            </div>
          </div>

          <!-- Product info -->
          <div class="mt-10 px-4 sm:mt-16 sm:px-0 lg:mt-0">
            <div class="flex justify-between items-start">
              <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">{name}</h1>
                <p class="mt-1 text-sm text-gray-500 uppercase tracking-wide">{brand}</p>
              </div>
              <p class="text-3xl font-semibold text-gray-900">{basePrice} Bs</p>
            </div>

            <div class="mt-6">
              <h3 class="sr-only">Descripción</h3>
              <div class="space-y-6 text-base text-gray-700">
                <p>{description || "Sin descripción disponible."}</p>
              </div>
            </div>

            {uniqueColors.length > 0 && (
              <div class="mt-8">
                <h3 class="text-sm font-medium text-gray-900">Color</h3>
                <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
                  {uniqueColors.map((colorAttr) => {
                    const color = colorAttr as string;
                    const colorValue = getColorHex(color);
                    const isLight = ["blanco", "crema", "amarillo", "white", "blanco"].includes(color.toLowerCase());
                    const isAnimalPrint = color.toLowerCase() === "print";
                    
                    return (
                      <button
                        type="button"
                        class="color-option flex items-center gap-3 rounded-xl border-2 py-3 px-4 text-sm font-medium transition-all hover:bg-gray-50 focus:outline-none border-gray-100 bg-gray-50/50"
                        data-color={color}
                      >
                        <div 
                          class={`h-4 w-4 rounded-full border border-black/10 shrink-0 ${isAnimalPrint ? "bg-gradient-to-br from-amber-700 via-amber-600 to-amber-800" : ""}`}
                          style={!isAnimalPrint ? `background-color: ${colorValue}; ${isLight ? "border: 1px solid #E5E7EB;" : ""}` : ""}
                        >
                          {isAnimalPrint && (
                            <div
                              class="w-full h-full rounded-full"
                              style={`background-image: url('${printImg.src}'); background-size: cover;`}
                            />
                          )}
                        </div>
                        <span class="truncate capitalize">{color}</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            {uniqueSizes.length > 0 && (
              <div class="mt-8">
                <h3 class="text-sm font-medium text-gray-900">Talla</h3>
                <div class="mt-3 grid grid-cols-4 gap-3">
                  {uniqueSizes.map((size) => (
                    <button
                      type="button"
                      class="size-option flex items-center justify-center rounded-md border py-3 px-3 text-sm font-medium uppercase hover:bg-gray-50 focus:outline-none transition-all border-gray-300"
                      data-size={size}
                    >
                      {size}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <!-- Stock indicator -->
            <div id="stock-indicator" class="mt-4 hidden">
              <p class="text-sm font-medium text-gray-900">
                Disponibilidad: <span id="stock-value" class="text-secondary font-bold"></span>
              </p>
            </div>

            <div class="mt-10">
              <button
                type="button"
                id="whatsapp-btn"
                class="flex w-full items-center justify-center gap-3 rounded-xl bg-green-600 px-8 py-4 text-lg font-bold text-white shadow-lg hover:bg-green-700 transition-all active:scale-95"
              >
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
                Comprar por WhatsApp
              </button>
              <p class="mt-4 text-center text-xs text-gray-500">
                Selecciona tu talla y coordinaremos la entrega.
              </p>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>

  <!-- Pass data to script -->
  <script is:inline define:vars={{ variants }}>
    window.productVariants = variants;
  </script>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const mainImg = document.getElementById("main-product-image");
      const thumbBtns = document.querySelectorAll(".thumb-btn");
      const sizeBtns = document.querySelectorAll(".size-option");
      const colorBtns = document.querySelectorAll(".color-option");
      const whatsappBtn = document.getElementById("whatsapp-btn");
      const stockIndicator = document.getElementById("stock-indicator");
      const stockValue = document.getElementById("stock-value");
      
      const variants = window.productVariants || [];
      let selectedSize = "";
      let selectedColor = "";

      function updateStockDisplay() {
        if (!selectedSize || !selectedColor) {
          stockIndicator.classList.add("hidden");
          return;
        }

        const variant = variants.find(v => 
          v.size?.toLowerCase() === selectedSize.toLowerCase() && 
          v.color?.toLowerCase() === selectedColor.toLowerCase()
        );

        if (variant) {
          stockIndicator.classList.remove("hidden");
          stockValue.textContent = variant.stock > 5 ? "En stock" : `¡Últimas ${variant.stock} unidades!`;
        } else {
          stockIndicator.classList.add("hidden");
        }
      }

      function updateSizeAvailability() {
        if (!selectedColor) return;

        const availableSizes = variants
          .filter(v => v.color?.toLowerCase() === selectedColor.toLowerCase() && v.stock > 0)
          .map(v => v.size?.toLowerCase());

        sizeBtns.forEach(btn => {
          const btnSize = btn.getAttribute("data-size")?.toLowerCase();
          if (availableSizes.includes(btnSize)) {
            btn.classList.remove("opacity-20", "cursor-not-allowed", "pointer-events-none");
            btn.classList.add("opacity-100", "cursor-pointer");
          } else {
            btn.classList.add("opacity-20", "cursor-not-allowed", "pointer-events-none");
            btn.classList.remove("opacity-100", "cursor-pointer");
            if (selectedSize.toLowerCase() === btnSize) {
              selectedSize = "";
              btn.classList.remove("border-secondary", "bg-secondary/10", "text-secondary");
              btn.classList.add("border-gray-300");
            }
          }
        });
      }

      // Image switching
      thumbBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const newUrl = btn.getAttribute("data-full");
          if (mainImg && newUrl) mainImg.src = newUrl;
          
          thumbBtns.forEach(b => b.classList.remove("ring-2", "ring-secondary"));
          btn.classList.add("ring-2", "ring-secondary");
        });
      });

      // Color selection
      colorBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          selectedColor = btn.getAttribute("data-color") || "";
          
          // Update button styles
          colorBtns.forEach(b => {
             b.classList.remove("border-secondary", "bg-secondary/5", "text-secondary", "shadow-sm");
             b.classList.add("border-gray-100", "bg-gray-50/50");
          });
          btn.classList.remove("border-gray-100", "bg-gray-50/50");
          btn.classList.add("border-secondary", "bg-secondary/5", "text-secondary", "shadow-sm");

          // Filter thumbnails
          const formattedSelectedColor = selectedColor.toLowerCase();
          let firstVisibleThumb = null;
          let currentMainStillVisible = false;

          thumbBtns.forEach(thumb => {
            const thumbColor = (thumb.getAttribute("data-color") || "").toLowerCase();
            const isVisible = !thumbColor || thumbColor === formattedSelectedColor;
            
            if (isVisible) {
              thumb.style.display = "flex";
              if (!firstVisibleThumb) firstVisibleThumb = thumb;
              if (thumb.getAttribute("data-full") === mainImg.src) currentMainStillVisible = true;
            } else {
              thumb.style.display = "none";
            }
          });

          // Update main image if current one is hidden
          if (!currentMainStillVisible && firstVisibleThumb) {
            const newUrl = firstVisibleThumb.getAttribute("data-full");
            if (mainImg && newUrl) {
              mainImg.src = newUrl;
              thumbBtns.forEach(b => b.classList.remove("ring-2", "ring-secondary"));
              firstVisibleThumb.classList.add("ring-2", "ring-secondary");
            }
          }

          updateSizeAvailability();
          updateStockDisplay();
        });
      });

      // Size selection
      sizeBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          selectedSize = btn.getAttribute("data-size") || "";
          sizeBtns.forEach(b => {
             b.classList.remove("border-secondary", "bg-secondary/10", "text-secondary");
             b.classList.add("border-gray-300");
          });
          btn.classList.remove("border-gray-300");
          btn.classList.add("border-secondary", "bg-secondary/10", "text-secondary");
          
          updateStockDisplay();
        });
      });

      // WhatsApp logic
      whatsappBtn?.addEventListener("click", () => {
        if (!selectedSize && sizeBtns.length > 0) {
          alert("Por favor selecciona una talla");
          return;
        }
        if (!selectedColor && colorBtns.length > 0) {
          alert("Por favor selecciona un color");
          return;
        }

        const url = window.location.href;
        const productName = document.querySelector("h1")?.textContent;
        const message = `¡Hola! Me interesa este producto: \n\n*${productName}*\n${selectedColor ? `Color: ${selectedColor}\n` : ""}${selectedSize ? `Talla: ${selectedSize}\n` : ""}\nLink: ${url}`;
        const whatsappUrl = `https://api.whatsapp.com/send/?phone=59165864255&text=${encodeURIComponent(message)}`;
        
        window.open(whatsappUrl, "_blank");
      });

      // Auto-select unique options
      if (colorBtns.length === 1) {
        colorBtns[0].click();
      }
      if (sizeBtns.length === 1) {
        sizeBtns[0].click();
      }
    });
  </script>
</Layout>
