---
import Layout from "../../layouts/Layout.astro";
import { products } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id.toString() },
    props: { product },
  }));
}

const { product } = Astro.props;
const { title, price, description, images, sizes, categories, color } = product;
const [mainImage, ...otherImages] = images;

// Transform Cloudinary URL with different optimizations based on usage
const transformCloudinaryUrl = (
  url: string,
  type: "thumbnail" | "main" | "lightbox"
): string => {
  if (!url || !url.includes("cloudinary.com")) return url;

  const transformations = {
    thumbnail: "w_150,h_150,c_fill,f_auto,q_auto",
    main: "w_600,h_600,c_fit,f_auto,q_auto,e_sharpen:50",
    lightbox: "w_1200,h_1200,c_fit,f_auto,q_80,e_sharpen:30",
  };

  return url.replace("/upload/", `/upload/${transformations[type]}/`);
};
---

<Layout title={`${title} | Raquel Boutique`}>
  <div class="bg-white">
    <div class="pt-6 pb-16 sm:pb-24">
      <nav
        aria-label="Breadcrumb"
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
      >
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <div class="flex items-center">
              <a
                href="/"
                class="mr-4 text-sm font-medium text-gray-900 hover:text-primary"
                >Inicio</a
              >
              <svg
                viewBox="0 0 6 20"
                aria-hidden="true"
                class="h-5 w-auto text-gray-300"
              >
                <path
                  d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z"
                  fill="currentColor"></path>
              </svg>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <a
                href={`/catalogo?category=${encodeURIComponent(categories[0])}`}
                class="mr-4 text-sm font-medium text-gray-900 hover:text-primary"
                >{categories[0]}</a
              >
              <svg
                viewBox="0 0 6 20"
                aria-hidden="true"
                class="h-5 w-auto text-gray-300"
              >
                <path
                  d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z"
                  fill="currentColor"></path>
              </svg>
            </div>
          </li>
          <li class="text-sm">
            <a
              href="#"
              aria-current="page"
              class="font-medium text-gray-500 hover:text-gray-600">{title}</a
            >
          </li>
        </ol>
      </nav>

      <div class="mx-auto mt-8 max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8">
          <!-- Image gallery -->
          <div class="flex flex-col-reverse">
            <!-- Image selector -->
            <div class="mx-auto mt-6 w-full max-w-2xl lg:max-w-none">
              <div
                class="grid grid-cols-4 gap-3 sm:gap-6"
                aria-orientation="horizontal"
                role="tablist"
              >
                {
                  images.map((image, index) => (
                    <button
                      id={`tab-${index}`}
                      class={`relative flex h-24 cursor-pointer items-center justify-center rounded-md bg-white text-sm font-medium uppercase text-gray-900 hover:bg-gray-50 focus:outline-none focus:ring focus:ring-opacity-50 focus:ring-offset-4 ${index === 0 ? "ring-2 ring-secondary" : ""}`}
                      role="tab"
                      type="button"
                      data-image-url={image}
                      data-index={index}
                    >
                      <span class="sr-only">Ver imagen {index + 1}</span>
                      <span class="absolute inset-0 overflow-hidden rounded-md">
                        <img
                          src={transformCloudinaryUrl(image, "thumbnail")}
                          alt=""
                          class="h-full w-full object-cover object-center"
                        />
                      </span>
                      <span
                        class="pointer-events-none absolute inset-0 rounded-md ring-2 ring-transparent ring-offset-2"
                        aria-hidden="true"
                      />
                    </button>
                  ))
                }
              </div>
            </div>

            <div
              class="w-full max-h-[450px] flex items-center justify-center overflow-hidden cursor-pointer"
              id="main-image-container"
            >
              <img
                id="main-product-image"
                src={transformCloudinaryUrl(mainImage, "main")}
                alt={title}
                class="h-full w-full max-h-[450px] object-contain sm:rounded-lg transition-transform hover:scale-105"
              />
            </div>
          </div>

          <!-- Lightbox Modal -->
          <div
            id="image-lightbox"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4"
          >
            <button
              id="close-lightbox"
              class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10"
              aria-label="Cerrar"
            >
              <svg
                class="h-8 w-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>

            <!-- Previous Button -->
            <button
              id="prev-image"
              class="absolute left-4 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 transition-colors bg-black/50 rounded-full p-3 hover:bg-black/70"
              aria-label="Imagen anterior"
            >
              <svg
                class="h-8 w-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>

            <img
              id="lightbox-image"
              src={transformCloudinaryUrl(mainImage, "lightbox")}
              alt={title}
              class="max-h-[90vh] max-w-[90vw] object-contain"
            />

            <!-- Next Button -->
            <button
              id="next-image"
              class="absolute right-4 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 transition-colors bg-black/50 rounded-full p-3 hover:bg-black/70"
              aria-label="Siguiente imagen"
            >
              <svg
                class="h-8 w-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>

            <!-- Image counter -->
            <div
              class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white bg-black/50 px-4 py-2 rounded-full text-sm"
            >
              <span id="current-image-index">1</span> / <span id="total-images"
                >{images.length}</span
              >
            </div>
          </div>

          <script define:vars={{ images }}>
            document.addEventListener("DOMContentLoaded", () => {
              const mainImage = document.getElementById("main-product-image");
              const mainImageContainer = document.getElementById(
                "main-image-container"
              );
              const thumbnails = document.querySelectorAll("[data-image-url]");
              const lightbox = document.getElementById("image-lightbox");
              const lightboxImage = document.getElementById("lightbox-image");
              const closeLightbox = document.getElementById("close-lightbox");
              const prevButton = document.getElementById("prev-image");
              const nextButton = document.getElementById("next-image");
              const currentIndexSpan = document.getElementById(
                "current-image-index"
              );

              let currentImageIndex = 0;
              const imageUrls = images.map((img) =>
                typeof img === "string" ? img : img.url
              );

              // Transform Cloudinary URLs in JavaScript
              function transformCloudinaryUrl(url, type) {
                if (!url || !url.includes("cloudinary.com")) return url;

                const transformations = {
                  main: "w_600,h_600,c_fit,f_auto,q_auto,e_sharpen:50",
                  lightbox: "w_1200,h_1200,c_fit,f_auto,q_80,e_sharpen:30",
                };

                return url.replace(
                  "/upload/",
                  `/upload/${transformations[type]}/`
                );
              }

              function updateLightboxImage(index) {
                currentImageIndex = index;
                if (lightboxImage && imageUrls[index]) {
                  lightboxImage.src = transformCloudinaryUrl(
                    imageUrls[index],
                    "lightbox"
                  );
                }
                if (currentIndexSpan) {
                  currentIndexSpan.textContent = (index + 1).toString();
                }

                // Update thumbnail active state
                thumbnails.forEach((t, i) => {
                  if (i === index) {
                    t.classList.add("ring-2", "ring-secondary");
                  } else {
                    t.classList.remove("ring-2", "ring-secondary");
                  }
                });
              }

              function showNextImage() {
                const nextIndex = (currentImageIndex + 1) % imageUrls.length;
                updateLightboxImage(nextIndex);
                if (mainImage) {
                  mainImage.src = transformCloudinaryUrl(
                    imageUrls[nextIndex],
                    "main"
                  );
                }
              }

              function showPrevImage() {
                const prevIndex =
                  (currentImageIndex - 1 + imageUrls.length) % imageUrls.length;
                updateLightboxImage(prevIndex);
                if (mainImage) {
                  mainImage.src = transformCloudinaryUrl(
                    imageUrls[prevIndex],
                    "main"
                  );
                }
              }

              // Thumbnail click handler
              thumbnails.forEach((thumbnail, index) => {
                thumbnail.addEventListener("click", () => {
                  const imageUrl = thumbnail.getAttribute("data-image-url");

                  if (mainImage && imageUrl) {
                    mainImage.src = transformCloudinaryUrl(imageUrl, "main");
                    currentImageIndex = index;
                    updateLightboxImage(currentImageIndex); // Update lightbox and counter
                  }

                  // Update active state (already handled by updateLightboxImage)
                });
              });

              // Open lightbox on main image click
              mainImageContainer?.addEventListener("click", () => {
                if (lightbox && mainImage) {
                  lightbox.classList.remove("hidden");
                  lightbox.classList.add("flex");
                  // Find the index of the current main image
                  const currentMainImageSrc = mainImage.src;
                  const index = imageUrls.findIndex(
                    (url) => url === currentMainImageSrc
                  );
                  if (index !== -1) {
                    updateLightboxImage(index);
                  } else {
                    updateLightboxImage(0); // Default to first image if not found
                  }
                }
              });

              // Close lightbox
              closeLightbox?.addEventListener("click", () => {
                if (lightbox) {
                  lightbox.classList.add("hidden");
                  lightbox.classList.remove("flex");
                }
              });

              // Close lightbox on background click
              lightbox?.addEventListener("click", (e) => {
                if (e.target === lightbox) {
                  lightbox.classList.add("hidden");
                  lightbox.classList.remove("flex");
                }
              });

              // Navigation buttons
              prevButton?.addEventListener("click", showPrevImage);
              nextButton?.addEventListener("click", showNextImage);

              // Keyboard navigation
              document.addEventListener("keydown", (e) => {
                if (lightbox && !lightbox.classList.contains("hidden")) {
                  if (e.key === "Escape") {
                    lightbox.classList.add("hidden");
                    lightbox.classList.remove("flex");
                  } else if (e.key === "ArrowRight") {
                    showNextImage();
                  } else if (e.key === "ArrowLeft") {
                    showPrevImage();
                  }
                }
              });
            });
          </script>

          <!-- Product info -->
          <div class="mt-10 px-4 sm:mt-16 sm:px-0 lg:mt-0">
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">
              {title}
            </h1>

            <div class="mt-3">
              <h2 class="sr-only">Información del producto</h2>
              <p class="text-3xl tracking-tight text-gray-900">{price} Bs</p>
            </div>

            <div class="mt-6">
              <h3 class="sr-only">Descripción</h3>
              <div class="space-y-6 text-base text-gray-700">
                <p>{description}</p>
              </div>
            </div>

            <div class="mt-6">
              <div class="flex items-center">
                <h3 class="text-sm font-medium text-gray-900">Color:</h3>
                <p class="ml-2 text-sm text-gray-500">{color}</p>
              </div>
            </div>

            <div class="mt-6">
              <!-- Sizes -->
              <div class="mt-8">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-medium text-gray-900">Talla</h3>
                </div>

                <div
                  class="mt-2 grid grid-cols-3 gap-3 sm:grid-cols-6"
                  id="size-selector"
                >
                  {
                    sizes.map((size, index) => (
                      <button
                        type="button"
                        data-size={size}
                        class={`size-option relative flex cursor-pointer items-center justify-center rounded-md border-2 py-3 px-3 text-sm font-medium uppercase shadow-sm transition-all ${index === 0 ? "border-secondary bg-secondary/10 text-gray-900" : "border-gray-300 bg-white text-gray-900 hover:bg-gray-50"}`}
                      >
                        <span>{size}</span>
                      </button>
                    ))
                  }
                </div>
              </div>

              <div class="mt-10 flex flex-col gap-3">
                <button
                  type="button"
                  id="whatsapp-button"
                  class="flex w-full items-center justify-center gap-2 rounded-md border border-transparent bg-green-600 py-3 px-8 text-base font-medium text-white hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-colors"
                >
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                    ></path>
                  </svg>
                  Comprar por WhatsApp
                </button>
                <p class="text-xs text-center text-gray-500">
                  Selecciona una talla y te contactaremos por WhatsApp
                </p>
              </div>
            </div>

            <script define:vars={{ title, productId: product.id }}>
              document.addEventListener("DOMContentLoaded", () => {
                const sizeButtons = document.querySelectorAll(".size-option");
                const whatsappButton =
                  document.getElementById("whatsapp-button");
                let selectedSize =
                  sizeButtons[0]?.getAttribute("data-size") || "";

                // Handle size selection
                sizeButtons.forEach((button) => {
                  button.addEventListener("click", () => {
                    // Remove active state from all buttons
                    sizeButtons.forEach((btn) => {
                      btn.classList.remove(
                        "border-secondary",
                        "bg-secondary/10"
                      );
                      btn.classList.add("border-gray-300", "bg-white");
                    });

                    // Add active state to clicked button
                    button.classList.remove("border-gray-300", "bg-white");
                    button.classList.add("border-secondary", "bg-secondary/10");

                    // Update selected size
                    selectedSize = button.getAttribute("data-size");
                  });
                });

                // Handle WhatsApp button click
                whatsappButton?.addEventListener("click", () => {
                  const currentUrl = window.location.href;
                  const message = `Hola! Me interesa este producto:\n\n${title}\nTalla: ${selectedSize}\n\n${currentUrl}`;
                  const whatsappUrl = `https://api.whatsapp.com/send/?phone=59165864255&text=${encodeURIComponent(message)}`;

                  // Track WhatsApp click event
                  if (typeof gtag !== "undefined") {
                    gtag("event", "click_whatsapp_product", {
                      event_category: "engagement",
                      event_label: title,
                      value: 1,
                    });
                  }

                  window.open(whatsappUrl, "_blank");
                });
              });
            </script>

            <section
              aria-labelledby="details-heading"
              class="mt-12 border-t border-gray-200 pt-6"
            >
              <h2 id="details-heading" class="sr-only">Detalles adicionales</h2>

              <div class="space-y-4">
                <div>
                  <h3 class="font-medium text-gray-900">Categorías</h3>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {
                      categories.map((cat) => (
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-0.5 text-sm font-medium text-gray-800">
                          {cat}
                        </span>
                      ))
                    }
                  </div>
                </div>
                <!-- <div>
                  <h3 class="font-medium text-gray-900">
                    Envío y Devoluciones
                  </h3>
                  <p class="mt-2 text-sm text-gray-500">
                    Envío gratuito en pedidos superiores a $100. Devoluciones
                    gratuitas dentro de los 30 días.
                  </p>
                </div> -->
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
