---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import ProductCard from "../components/ProductCard.astro";

import { products } from "../data/products";

// Show maximum 8 products on home page
const MAX_PRODUCTS = 8;
const displayedProducts = products.slice(0, MAX_PRODUCTS);
const hasMoreProducts = products.length > MAX_PRODUCTS;
---

<Layout title="Catálogo de Moda | Colección 2024">
  <main>
    <div class="bg-white pb-6 sm:pb-8 lg:pb-12">
      <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
        <section
          class="flex flex-col items-center justify-between gap-6 sm:gap-10 md:gap-16 lg:flex-row"
        >
          <!-- Hero Content -->
          <div
            class="flex flex-col justify-center sm:text-center lg:py-12 lg:text-left xl:w-5/12 lg:w-1/2"
          >
            <p
              class="mb-4 font-semibold text-primary md:mb-6 md:text-lg xl:text-xl"
            >
              Nueva Colección
            </p>
            <h1
              class="mb-8 text-4xl font-bold text-gray-900 sm:text-5xl md:mb-12 md:text-6xl"
            >
              Descubre tu estilo único
            </h1>
            <p
              class="mb-8 leading-relaxed text-gray-500 md:mb-12 lg:w-4/5 xl:text-lg"
            >
              Explora nuestra selección exclusiva de prendas diseñadas para
              resaltar tu belleza y confianza.
            </p>
            <div
              class="flex flex-col gap-2.5 sm:flex-row sm:justify-center lg:justify-start"
            >
              <a
                href="/catalogo"
                class="inline-block rounded-lg bg-gray-900 px-8 py-3 text-center text-sm font-semibold text-white outline-none ring-indigo-300 transition duration-100 hover:bg-gray-800 focus-visible:ring active:bg-gray-700 md:text-base"
                >Ver Catálogo</a
              >
            </div>
          </div>
          <!-- Hero Image -->
          <div
            class="h-48 overflow-hidden rounded-lg bg-gray-100 shadow-lg lg:h-auto xl:w-5/12 lg:w-1/2"
          >
            <img
              src="https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1000&auto=format&fit=crop"
              loading="lazy"
              alt="Photo by Fakurian Design"
              class="h-full w-full object-cover object-center"
            />
          </div>
        </section>
      </div>
    </div>

    <div class="text-center mt-16 mb-8">
      <h2 class="text-3xl font-bold text-gray-900">Nuestros Productos</h2>
      <p class="mt-4 text-gray-500">
        Lo mejor de la temporada seleccionado para ti
      </p>
    </div>

    <Gallery>
      {
        displayedProducts.map((product) => (
          <ProductCard
            id={product.id}
            title={product.title}
            price={product.price}
            categories={product.categories}
            color={product.color}
            images={product.images}
            sizes={product.sizes}
          />
        ))
      }
    </Gallery>

    {
      hasMoreProducts && (
        <div class="text-center mt-12 mb-16">
          <a
            href="/catalogo"
            class="inline-block rounded-lg bg-gray-900 px-8 py-3 text-center text-sm font-semibold text-white outline-none ring-indigo-300 transition duration-100 hover:bg-secondary focus-visible:ring active:bg-gray-700 md:text-base"
          >
            Ver Catálogo Completo
          </a>
        </div>
      )
    }

    <!-- Cómo Trabajamos Section -->
    <div class="bg-gray-50 py-16 sm:py-20 mt-16">
      <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl">
            ¿Cómo Trabajamos?
          </h2>
          <p class="mt-4 text-gray-600">Tu satisfacción es nuestra prioridad</p>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Envíos Express -->
          <div
            class="flex flex-col items-center text-center p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow"
          >
            <div
              class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
              >
                <path d="M16 3h5v5"></path>
                <path d="M8 3H3v5"></path>
                <path d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3"></path>
                <path d="m15 9 6-6"></path>
                <path d="M9 21h6"></path>
                <path d="M12 3v9"></path>
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-900">
              Envíos Express
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Envíos a todo Bolivia 🇧🇴 Los envíos se hacen el mismo día de la
              compra por la flota de su preferencia
            </p>
          </div>

          <!-- Delivery 24 Horas -->
          <div
            class="flex flex-col items-center text-center p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow"
          >
            <div
              class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
              >
                <path
                  d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"
                ></path>
                <path d="M15 18H9"></path>
                <path
                  d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"
                ></path>
                <circle cx="17" cy="18" r="2"></circle>
                <circle cx="7" cy="18" r="2"></circle>
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-900">
              Delivery las 24 Horas en Santa Cruz
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Entregas a Domicilio por Yango las 24 horas
            </p>
          </div>

          <!-- Pagos Rápidos y Seguros -->
          <div
            class="flex flex-col items-center text-center p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow"
          >
            <div
              class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
              >
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                <line x1="2" x2="22" y1="10" y2="10"></line>
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-900">
              Pagos Rápidos y Seguros
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Pago FÁCIL. Paga por QR o en Efectivo sin problemas
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
