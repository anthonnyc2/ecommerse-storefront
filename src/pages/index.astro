---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import ProductCard from "../components/ProductCard.astro";
import JsonLd from "../components/JsonLd.astro";
import HeroCollage from "../components/HeroCollage.astro";

import {
  getCatalogProducts,
  getCategories,
  getProductBySlug,
} from "../services/api";
import {
  HERO_SLOTS,
  HERO_TILE_COUNT,
  pickHeroTiles,
} from "../services/heroCollage";

// sort=mix tells the backend to fetch ALL products, interleave by category,
// and then apply the limit — guaranteeing a real mix in a single request.
const { products: mixed, total } = await getCatalogProducts({
  sort: "mix",
  limit: 8,
  page: 1,
});

const hasMoreProducts = total > 8;
const categories = await getCategories();

// The collage only shows when all its slots are filled, so the layout never
// looks half empty.
const heroTiles = await pickHeroTiles(HERO_SLOTS, getProductBySlug);
const showCollage = heroTiles.length === HERO_TILE_COUNT;

const siteOrigin = Astro.site ?? new URL("https://raquel-boutique.com");
const siteUrl = new URL("/", siteOrigin).href;

const storeJsonLd = {
  "@context": "https://schema.org",
  "@type": "ClothingStore",
  "@id": `${siteUrl}#store`,
  name: "Raquel Boutique",
  url: siteUrl,
  logo: new URL("/og-default.png", siteOrigin).href,
  image: new URL("/og-default.png", siteOrigin).href,
  description:
    "Boutique de moda femenina en Santa Cruz, Bolivia: vestidos, conjuntos y lencería con envíos a todo el país.",
  telephone: "+59165864255",
  email: "contacto@raquel-boutique.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Santa Cruz de la Sierra",
    addressCountry: "BO",
  },
  areaServed: "BO",
  currenciesAccepted: "BOB",
  sameAs: [
    "https://www.instagram.com/raquelboutique.bo",
    "https://www.facebook.com/raquelboutiquebo",
    "https://www.tiktok.com/@raquelboutiquebo",
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Raquel Boutique",
  url: siteUrl,
  inLanguage: "es-BO",
};
---

<Layout
  title="Raquel Boutique | Moda femenina en Santa Cruz, Bolivia"
  description="Vestidos, conjuntos y lencería femenina en Santa Cruz, Bolivia. Modelos exclusivos, pedidos por WhatsApp y envíos a todo el país."
>
  <Fragment slot="head">
    <JsonLd data={storeJsonLd} />
    <JsonLd data={websiteJsonLd} />
  </Fragment>
  <div>
    <div
      class="bg-gradient-to-br from-primary/50 to-secondary/30 py-16 sm:py-24"
    >
      <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
        <section
          class:list={[
            "flex flex-col items-center text-center",
            showCollage &&
              "gap-12 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16 lg:text-left",
          ]}
        >
          <!-- Hero Content -->
          <div
            class:list={[
              "flex max-w-2xl flex-col items-center",
              showCollage ? "lg:items-start" : "mx-auto",
            ]}
          >
            <p
              class="mb-4 font-semibold text-plum md:mb-6 md:text-lg xl:text-xl"
            >
              Santa Cruz · Bolivia
            </p>
            <h1
              class="mb-8 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:mb-12 md:text-6xl"
            >
              Moda que te hace brillar
            </h1>
            <p
              class="mb-8 leading-relaxed text-gray-700 md:mb-12 xl:text-lg font-medium"
            >
              Vestidos, conjuntos, lencería femenina y más. Modelos exclusivos
              para que te veas y sientas distinta. Pide por WhatsApp y recibe en
              todo el país.
            </p>
            <a href="/catalogo" class="btn btn-plum btn-xl md:text-base"
              >Ver Catálogo</a
            >
          </div>
          {showCollage && <HeroCollage tiles={heroTiles} />}
        </section>
      </div>
    </div>

    <!-- Categorías -->
    {
      categories.length > 0 && (
        <div class="mx-auto max-w-screen-2xl px-4 md:px-8 mt-12">
          <div class="flex flex-wrap items-center justify-center gap-2.5">
            <a href="/catalogo" class="btn btn-outline btn-md">
              Ver todo
            </a>
            {categories.map((cat) => (
              <a
                href={`/catalogo?category=${encodeURIComponent(cat.name)}`}
                class="btn btn-outline btn-md capitalize"
              >
                {cat.name}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <div class="text-center mt-16 mb-8">
      <p
        class="mb-2 text-sm font-semibold uppercase tracking-widest text-berry"
      >
        Temporada actual
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900">
        Nuestros Productos
      </h2>
      <p class="mt-3 text-gray-500">
        Lo mejor de la temporada seleccionado para ti
      </p>
    </div>

    <Gallery listName="destacados">
      {mixed.map((product) => <ProductCard product={product} />)}
    </Gallery>

    {
      hasMoreProducts && (
        <div class="text-center mt-12 mb-16">
          <a href="/catalogo" class="btn btn-outline-dark btn-xl md:text-base">
            Ver Catálogo Completo
          </a>
        </div>
      )
    }

    <!-- Reseñas Section -->
    <div class="py-16 sm:py-20">
      <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
        <div class="text-center mb-12">
          <p
            class="mb-2 text-sm font-semibold uppercase tracking-widest text-plum"
          >
            Clientas felices
          </p>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900">
            Lo que dicen nuestras clientas
          </h2>
          <p class="mt-3 text-gray-500">Compras reales de nuestras clientas</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          {
            [
              {
                quote:
                  "Me encantó la calidad y el empaque. ¡100% recomendado, volvería a comprar sin dudarlo!",
                author: "María G.",
              },
              {
                quote:
                  "Me ayudaron a elegir la talla perfecta con mucha paciencia. Se nota que les importa cada clienta.",
                author: "Lucía M.",
              },
              {
                quote:
                  "El delivery por Yango fue rapidísimo. El vestido quedó perfecto.",
                author: "Amanda M.",
              },
              {
                quote:
                  "Super fácil hacer el pedido por WhatsApp. Me mandaron fotos de todo antes de confirmar, muy profesional.",
                author: "Valeria T.",
              },
            ].map(({ quote, author }) => (
              <figure class="flex flex-col gap-6 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
                <div class="flex gap-1" aria-label="5 de 5 estrellas">
                  {Array.from({ length: 5 }).map(() => (
                    <svg
                      class="h-5 w-5 text-berry"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <blockquote class="flex-1 text-gray-700 leading-relaxed">
                  "{quote}"
                </blockquote>
                <figcaption class="text-sm font-medium text-gray-500">
                  — {author}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>

    <!-- WhatsApp CTA -->
    <div
      class="bg-gradient-to-r from-primary/30 to-secondary/20 py-14 sm:py-16"
    >
      <div class="mx-auto max-w-screen-2xl px-4 md:px-8 text-center">
        <p
          class="mb-2 text-sm font-semibold uppercase tracking-widest text-plum"
        >
          Atención personalizada
        </p>
        <h2
          class="mb-3 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"
        >
          ¿Tienes dudas sobre tallas o colores?
        </h2>
        <p class="mb-8 text-gray-600 max-w-lg mx-auto">
          Escríbenos por WhatsApp y te asesoramos al instante. También puedes
          hacer tu pedido directamente desde el chat.
        </p>
        <a
          href="https://api.whatsapp.com/send/?phone=59165864255&text=Hola%2C%20me%20gustar%C3%ADa%20ver%20sus%20productos%20%F0%9F%9B%8D%EF%B8%8F"
          data-track="click_contact"
          data-placement="home_cta"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp btn-xl gap-2.5 shadow-sm md:text-base"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
            ></path>
          </svg>
          Escribirnos por WhatsApp
        </a>
      </div>
    </div>

    <!-- Cómo Trabajamos Section -->
    <div class="bg-gray-50 py-16 sm:py-20">
      <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
        <div class="text-center mb-12">
          <p
            class="mb-2 text-sm font-semibold uppercase tracking-widest text-berry"
          >
            Nuestro compromiso
          </p>
          <h2
            class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
          >
            ¿Cómo Trabajamos?
          </h2>
          <p class="mt-3 text-gray-500">Tu satisfacción es nuestra prioridad</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Envíos Express -->
          <div
            class="flex flex-col items-center text-center p-8 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/40 transition-all duration-300"
          >
            <div
              class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/15"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-700"
                aria-hidden="true"
              >
                <path d="m7.5 4.27 9 5.15"></path>
                <path
                  d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
                ></path>
                <path d="m3.3 7 8.7 5 8.7-5"></path>
                <path d="M12 22V12"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold tracking-tight text-gray-900">
              Envíos Express
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              Envíos a todo Bolivia. Los pedidos se despachan el mismo día de la
              compra por la flota de tu preferencia.
            </p>
          </div>

          <!-- Delivery 24 Horas -->
          <div
            class="flex flex-col items-center text-center p-8 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/40 transition-all duration-300"
          >
            <div
              class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-secondary/20"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-700"
                aria-hidden="true"
              >
                <path
                  d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"
                ></path>
                <path d="M15 18H9"></path>
                <path
                  d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"
                ></path>
                <circle cx="17" cy="18" r="2"></circle>
                <circle cx="7" cy="18" r="2"></circle>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold tracking-tight text-gray-900">
              Delivery en Santa Cruz
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              Entregas a domicilio las 24 horas dentro de la ciudad de Santa
              Cruz por Yango.
            </p>
          </div>

          <!-- Pagos Rápidos y Seguros -->
          <div
            class="flex flex-col items-center text-center p-8 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/40 transition-all duration-300"
          >
            <div
              class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/30"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-700"
                aria-hidden="true"
              >
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                <line x1="2" x2="22" y1="10" y2="10"></line>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold tracking-tight text-gray-900">
              Pagos Seguros
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              Paga por QR, transferencia bancaria o en efectivo. Rápido y sin
              complicaciones.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
