
echo "🔍 Optimizando el commit (lint-staged + typecheck)..."

# Formateamos y corregimos linting solo en archivos modificados
pnpm exec lint-staged

# Verificamos tipos de Astro/TypeScript en todo el proyecto
pnpm run typecheck

if [ $? -ne 0 ]; then
  echo "❌ Error: Validación de tipos fallida. El commit ha sido cancelado."
  exit 1
fi

pnpm run build

if [ $? -ne 0 ]; then
  echo "❌ Error: La construcción del proyecto falló. El commit ha sido cancelado."
  exit 1
fi

echo "✅ Validación exitosa. Procediendo con el commit..."
exit 0
