auto-install-peers=true
strict-peer-dependencies=false

# Hoist all deps to a flat node_modules layout, matching npm. pnpm's strict
# layout hides transitives under node_modules/.pnpm/, which breaks Node module
# resolution for project-root config files (astro.config.mjs, eslint.config.mjs)
# and for ESLint plugins like eslint-plugin-sonarjs that load TypeScript types
# from peer deps (got "Cannot read properties of undefined (reading 'FunctionType')").
# This is the npm-compatible layout.
shamefully-hoist=true
