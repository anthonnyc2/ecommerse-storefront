{
  "name": "rb",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.13.1"
  },
  "overrides": {
    "yaml": ">=2.2.2",
    "path-to-regexp": ">=6.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "prepare": "husky install",
    "test": "vitest run"
  },
  "lint-staged": {
    "*.{js,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/vercel": "^9.0.5",
    "@microsoft/clarity": "^1.0.2",
    "@nanostores/persistent": "^1.3.3",
    "@sentry/astro": "^10.47.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.18.1",
    "nanostores": "^1.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.0.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
